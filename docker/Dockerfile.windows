FROM fedora:latest

# MinGW toolchain + packaged dependencies
RUN dnf install -y \
    mingw64-gcc-c++ \
    mingw64-qt6-qtbase \
    mingw64-SDL3 \
    mingw64-libpng \
    mingw64-zlib \
    mingw64-curl \
    mingw64-openssl \
    cmake \
    make \
    git \
    && dnf clean all

# NOTE (GH #57): SDL2 used to be cross-built from a git clone here, because
# Fedora packaged only mingw-sdl2-compat (a shim over SDL3, which is what made
# the Windows bundling special case necessary). jnext links SDL3 directly now
# and Fedora packages mingw64-SDL3, so it is a plain dnf package above —
# the same one .github/workflows/{ci,release}.yml installs.
