    24                          IF __crt_org_bss_fardata_start
    25                              org	__crt_org_bss_fardata_start
    26                          ENDIF
    27                          IF !__crt_org_far
    28                              SECTION bss_far
    29                          ENDIF
    30                              SECTION bss_compiler
