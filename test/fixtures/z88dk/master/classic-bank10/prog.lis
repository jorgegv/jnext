z88dk/lib/target/zxn/classic/ram_crt0.asm:
    34                          
    35  0016  cd0000                call    _main           ; Call user program
    36                          __Exit:
    37  0019  e5                    push    hl
    38  001a  cd0000                call    crt0_exit
    39  001d  215827                ld      hl,10072        ;Restore hl' to what basic wants
    40  0020  d9                    exx
    41  0021  c1                    pop     bc
    42                              INCLUDE "crt/classic/crt_exit_eidi.inc"
z88dk/lib/crt/classic/crt_exit_eidi.inc:
     1                          ; ei/di state at the end of the program
     2                          
     3                             IF (__crt_enable_eidi & 0x10)
     4                                di
     5                             ENDIF
     6                          
     7                          IF !__CPU_INTEL__ && !__CPU_GBZ80__ && !__CPU_RABBIT__
     8                             IF (__crt_interrupt_mode_exit >= 0) && (__crt_interrupt_mode_exit <= 2)
     9                                   im __crt_interrupt_mode_exit
    10                             ENDIF
    11                          ENDIF
    12                          
    13                             IF (__crt_enable_eidi & 0x20)
    14                                ei
    15                             ENDIF
