    50                              SECTION bss_crt
    51                          IF CRT_ENABLE_STDIO = 1 && CLIB_FOPEN_MAX > 0
    52                              PUBLIC  __sgoioblk
    53                              PUBLIC  __sgoioblk_end
    54                          __sgoioblk:                     ;stdio control block
    55  0000  0000000000000000      defs    CLIB_FOPEN_MAX * 10
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              00000000          
    56                          __sgoioblk_end:                 ;end of stdio control block
    57                          ENDIF
    58                          
    59                          IF !DEFINED_basegraphics
    60                              PUBLIC  base_graphics
    61                          base_graphics:
    62  0064  0000                  defw    0                   ;Address of graphics map
    63                          ENDIF
    64                          
    65                          IF __clib_malloc_heap_size > 0
    66                              PUBLIC  _heap
    67                          _heap:
    68                              defw    0,0                 ;populated by crt_heap_init.inc
    69                          __autoheap:
    70                              defs    __clib_malloc_heap_size
    71                          
    72                          ELIF DEFINED_CRT_HEAP_AMALLOC ||  __crt_stack_size > 0
    73                              PUBLIC  _heap
    74                          _heap:
    75                              defw 0
    76                              defw 0
    77                          ENDIF
    78                          
    79                          IF CLIB_BALLOC_TABLE_SIZE > 0
    80                              ; create balloc table
    81                              SECTION data_alloc_balloc
    82                              PUBLIC  __balloc_array
    83                          __balloc_array:
    84                              defw __balloc_table
    85                          
    86                              SECTION bss_alloc_balloc
    87                              PUBLIC  __balloc_table
    88                          __balloc_table:
    89                              defs CLIB_BALLOC_TABLE_SIZE * 2
    90                          ENDIF
    91                          
    92                          IF __CPU_INTEL__ || __CPU_GBZ80__
    93                              PUBLIC  saved_hl            ;Temporary store used by compiler for Intel & GB
    94                          saved_hl:
    95                              defw    0                   ; Temp store for hl
    96                          ENDIF
