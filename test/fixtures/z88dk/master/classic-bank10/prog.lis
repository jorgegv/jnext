   563                                ENDIF
   564                             ENDIF
   565                          ENDIF
   566                          
   567                          IF DEFINED_fgetc_cons
   568                            IF !DEFINED__fgetc_cons
   569                                PUBLIC _fgetc_cons
   570                                defc _fgetc_cons = fgetc_cons
   571                            ENDIF
   572                          ENDIF
   573                          
