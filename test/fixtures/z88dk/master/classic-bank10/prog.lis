     9                            IF __CPU_GBZ80__
    10                              ld      hl,sp+0
    11                              ld      d,h
    12                              ld      e,l
    13                              ld      hl,__exit_atexit_funcs
    14                              ld      a,e
    15                              ld      (hl+),a
    16                              ld      a,d
    17                              ld      (hl+),a
