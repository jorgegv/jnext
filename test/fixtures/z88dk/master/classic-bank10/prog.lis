   339                          ;--------
   340                          ; Allow a compile time switch between native output and ANSI terminal
   341                          ;
   342                          ; -pragma-need=ansiterminal
   343                          ;--------
   344                          
   345                          IF NEED_ansiterminal
   346                          	PUBLIC		fputc_cons
   347                          	EXTERN		fputc_cons_ansi
   348                          	EXTERN		puts_cons_ansi
   349                          	defc DEFINED_fputc_cons = 1
   350                          	defc DEFINED_puts_cons = 1
   351                          	defc fputc_cons = fputc_cons_ansi
   352                          
   353                          	; Bridge VT100 to gencon
   354                                  IF DEFINED_CLIB_ANSITERMINAL_BRIDGE & CLIB_ANSITERMINAL_BRIDGE != 0
   355                                      PUBLIC ansi_attr
   356                                      PUBLIC ansi_BEL
   357                                      PUBLIC ansi_cls
   358                                      PUBLIC ansi_CHAR
   359                                      PUBLIC ansi_del_line
   360                                      PUBLIC ansi_SCROLLUP
   361                                      EXTERN __gencon_ansi_attr
   362                                      EXTERN __gencon_ansi_BEL
   363                                      EXTERN __gencon_ansi_cls
   364                                      EXTERN __gencon_ansi_CHAR
   365                                      EXTERN __gencon_ansi_del_line
   366                                      EXTERN __gencon_ansi_SCROLLUP
   367                                      defc ansi_attr = __gencon_ansi_attr
   368                                      defc ansi_BEL = __gencon_ansi_BEL
   369                                      defc ansi_cls = __gencon_ansi_cls
   370                                      defc ansi_CHAR = __gencon_ansi_CHAR
   371                                      defc ansi_del_line = __gencon_ansi_del_line
   372                                      defc ansi_SCROLLUP = __gencon_ansi_SCROLLUP
   373                          
   374                                      ; We're using gencon, don't include an ANSIfont
   375                                      UNDEFINE TAR__no_ansifont
   376                                      defc TAR__no_ansifont = 1
   377                          	    IF !DEFINED_ansicolumns
   378                                          defc ansicolumns = CONSOLE_COLUMNS
   379                                          defc DEFINED_ansicolumns = 1
   380                                      ENDIF
   381                                  ENDIF
   382                          
   383                                 	PUBLIC ansicolumns
   384                          
   385                          	IF !TAR__no_ansifont
   386                                  	PUBLIC ansicharacter_pixelwidth
   387                          		PUBLIC ansifont
   388                                  	PUBLIC ansifont_is_packed
   389                                  ELSE
   390                                          defc DEFINED_ansifont = 1
   391                          	ENDIF
   392                          
   393                          	IF !ansipixels
   394                          		defc ansipixels = 256
   395                          	ENDIF
   396                          
   397                          	IF !DEFINED_ansicolumns
   398                          		 defc ansicolumns = 64
   399                          	ENDIF
   400                          
   401                          	UNDEFINE CONSOLE_COLUMNS
   402                          	defc CONSOLE_COLUMNS = ansicolumns
   403                          
   404                          	IF DEFINED_ansirows
   405                          		UNDEFINE CONSOLE_ROWS
   406                          		defc CONSOLE_ROWS = ansirows
   407                          	ENDIF
   408                          
   409                          
   410                          	IF (ansicolumns = (ansipixels/2))
   411                          	    defc ansicharacter_pixelwidth = 2
   412                                      IF !DEFINED_ansifont
   413                                      	EXTERN ansifont_f4pack
   414                          	    	defc ansifont = ansifont_f4pack
   415                                      	defc ansifont_is_packed = 1
   416                                      ENDIF
   417                          	ENDIF
   418                          	IF (ansicolumns = (ansipixels/3))
   419                          	    defc ansicharacter_pixelwidth = 3
   420                                      IF !DEFINED_ansifont
   421                                          EXTERN ansifont_f4pack
   422                          	        defc ansifont = ansifont_f4pack
   423                                          defc ansifont_is_packed = 1
   424                          	    ENDIF
   425                          	ENDIF
   426                          	IF (ansicolumns = (ansipixels/4))
   427                          	    defc ansicharacter_pixelwidth = 4
   428                                      IF !DEFINED_ansifont
   429                                          EXTERN ansifont_f4pack
   430                          	        defc ansifont = ansifont_f4pack
   431                                          defc ansifont_is_packed = 1
   432                          	    ENDIF
   433                          	ENDIF
   434                          	IF (ansicolumns = (ansipixels/5))
   435                          	    defc ansicharacter_pixelwidth = 5
   436                                      IF !DEFINED_ansifont
   437                                          EXTERN ansifont_f5
   438                          	        defc ansifont = ansifont_f5
   439                                          defc ansifont_is_packed = 0
   440                          	    ENDIF
   441                          	ENDIF
   442                          	IF (ansicolumns = (ansipixels/6))
   443                          	    defc ansicharacter_pixelwidth = 6
   444                                      IF !DEFINED_ansifont
   445                                          EXTERN ansifont_f6
   446                          	        defc ansifont = ansifont_f6
   447                                          defc ansifont_is_packed = 0
   448                          	    ENDIF
   449                          	ENDIF
   450                          	IF (ansicolumns = (ansipixels/7))
   451                          	    defc ansicharacter_pixelwidth = 7
   452                                      IF !DEFINED_ansifont
   453                                          EXTERN ansifont_f8
   454                          	        defc ansifont = ansifont_f8
   455                                          defc ansifont_is_packed = 0
   456                          	    ENDIF
   457                          	ENDIF
   458                          	IF (ansicolumns = (ansipixels/8))
   459                          	    defc ansicharacter_pixelwidth = 8
   460                                      IF !DEFINED_ansifont
   461                                          EXTERN ansifont_f8
   462                          	        defc ansifont = ansifont_f8
   463                                          defc ansifont_is_packed = 0
   464                          	    ENDIF
   465                          	ENDIF
   466                          	IF (ansicolumns = (ansipixels/9))
   467                          	    defc ansicharacter_pixelwidth = 9
   468                                      IF !DEFINED_ansifont
   469                                          EXTERN ansifont_f8
   470                          	        defc ansifont = ansifont_f8
   471                                          defc ansifont_is_packed = 0
   472                          	    ENDIF
   473                          	ENDIF
   474                          
   475                          	IF (ansipixels = 512)
   476                          		IF (ansicolumns = 48)
   477                          			defc ansicharacter_pixelwidth = 9
   478                          			IF !DEFINED_ansifont
   479                          				EXTERN ansifont_f8
   480                          				defc ansifont = ansifont_f8
   481                          				defc ansifont_is_packed = 0
   482                          			ENDIF
   483                          		ENDIF
   484                          		IF (ansicolumns = 80)
   485                          			defc ansicharacter_pixelwidth = 6
   486                          			IF !DEFINED_ansifont
   487                          				EXTERN ansifont_f6
   488                          				defc ansifont = ansifont_f6
   489                          				defc ansifont_is_packed = 0
   490                          			ENDIF
   491                          		ENDIF
   492                          		IF (ansicolumns = 160)
   493                          			defc ansicharacter_pixelwidth = 3
   494                          			IF !DEFINED_ansifont
   495                          				EXTERN ansifont_f4pack
   496                          				defc ansifont = ansifont_f4pack
   497                          				defc ansifont_is_packed = 1
   498                          			ENDIF
   499                          		ENDIF
   500                          	ENDIF
   501                          
   502                          	IF (ansipixels = 256)
   503                          		IF (ansicolumns = 24)
   504                          			defc ansicharacter_pixelwidth = 9
   505                          			IF !DEFINED_ansifont
   506                          				EXTERN ansifont_f8
   507                          				defc ansifont = ansifont_f8
   508                          				defc ansifont_is_packed = 0
   509                          			ENDIF
   510                          		ENDIF
   511                          		IF (ansicolumns = 40)
   512                          			defc ansicharacter_pixelwidth = 6
   513                          			IF !DEFINED_ansifont
   514                          				EXTERN ansifont_f6
   515                          				defc ansifont = ansifont_f6
   516                          				defc ansifont_is_packed = 0
   517                          			ENDIF
   518                          		ENDIF
   519                          		IF (ansicolumns = 80)
   520                          			defc ansicharacter_pixelwidth = 3
   521                          			IF !DEFINED_ansifont
   522                          				EXTERN ansifont_f4pack
   523                          				defc ansifont = ansifont_f4pack
   524                          				defc ansifont_is_packed = 1
   525                          			ENDIF
   526                          		ENDIF
   527                          	ENDIF
   528                          
   529                          ENDIF
   530                          
   531                          ; If it's not been overridden by anybody, lets use the native output
   532                          IF !DEFINED_fputc_cons
   533                          	PUBLIC		fputc_cons
   534                          	defc DEFINED_fputc_cons = 1
   535                                  IF !TAR__fputc_cons_generic
   536                          	     EXTERN	fputc_cons_native
   537                            	     defc fputc_cons = fputc_cons_native
   538                                  ELSE
   539                          	     EXTERN	fputc_cons_generic
   540                            	     defc fputc_cons = fputc_cons_generic
   541                                  ENDIF
   542                          ENDIF
   543                          
   544                          IF DEFINED_fputc_cons
   545                          	PUBLIC		_fputc_cons
   546                          	defc		_fputc_cons = fputc_cons
   547                          
   548                          ENDIF
   549                          
   550                          IF !DEFINED_getk
   551                             IF !DEFINED_fgetc_cons
   552                                IF TAR__fgetc_cons_inkey
