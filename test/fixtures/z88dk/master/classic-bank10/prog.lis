    29                              INCLUDE "crt/classic/crt_section_bss.inc"
z88dk/lib/crt/classic/crt_section_bss.inc:
     1                              SECTION BSS
     2                          IF __crt_org_bss
     3                              org     __crt_org_bss
     4                              defb    0   ; control name of bss binary
     5                          ELSE
     6                            ;; By default the final binary embeds the bss, use
     7                            ;; a pragma to disable it
     8                            IF CRT_TRIM_BSS
     9                              org -1
    10                            ENDIF
    11                          ENDIF
