z88dk/lib/crt/classic/crt_init_sp.inc:
     1                          IF __register_sp < -1
     2                          
     3                             IF __CPU_INTEL__
     4                               ld hl,(-__register_sp)      ; stack location is stored at memory address
     5                               ld sp,hl
     6                             ELSE
     7                               ld sp,(-__register_sp)      ; stack location is stored at memory address
     8                             ENDIF
     9                          
    10                          ELSE
    11                          
