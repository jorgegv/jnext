z88dk/lib/crt/classic/crt_section_standard.inc:
    30                          
    31                          ; For ROM compilation, the data section has to sit in RAM. It's placed
    32                          ; after the BSS section
    33                          IF __crt_model > 0
    34                              SECTION DATA
    35                              org     -1
    36                              defb    0		; control name of data binary
    37                              INCLUDE "crt/classic/crt_section_data.inc"
    38                          ENDIF
    39                              SECTION BSS_END
    40                          
    41                          ; On some targets, the program sits in low memory AND the screen can
    42                          ; only be accessed by paging it into low memory. To mitigate this
    43                          ; routines that access the screen are placed in high memory.
    44                          ;
    45                          ; We might have a similar issue with far code, so create a placeholder
    46                          ; for that as well
    47                          IF __crt_org_graphics > 0 || __crt_org_far > 0
    48                              SECTION	HIMEM
    49                          
    50                          IF __crt_org_graphics > 0
    51                              org	__crt_org_graphics
    52                          ELIF  __crt_org_far > 0
    53                              org	__crt_org_far
    54                          ENDIF
    55                              SECTION code_himem
    56                              SECTION rodata_himem
    57                              SECTION data_himem
    58                              SECTION bss_himem
    59                          IF __crt_org_graphics > 0
    60                              SECTION smc_clib
    61                              SECTION code_graphics
    62                              SECTION rodata_graphics
    63                              SECTION data_graphics
    64                              SECTION bss_graphics
    65                          ENDIF
    66                          
    67                          IF __crt_org_far > 0
    68                              SECTION code_far
    69                              SECTION code_l_sccz80_far
    70                              SECTION data_far
    71                              SECTION rodata_far
    72                              SECTION bss_far
    73                          ENDIF
    74                              SECTION HIMEM_END
    75                          ENDIF
    76                          
z88dk/lib/crt/classic/crt_section.inc:
    19                          ENDIF
    20                          
    21                          
    22                          ; The classic CRTs need some things setup, so do it
    23                          
    24                              SECTION code_crt_init
    25                          crt0_init:
    26                              INCLUDE "crt/classic/crt_initialise_bss.inc"
z88dk/lib/crt/classic/crt_initialise_bss.inc:
     1                          
     2                          IF CRT_INITIALIZE_BSS = 1
     3                              EXTERN  __BSS_head
     4                              EXTERN  __BSS_END_tail
     5  0000  af                    xor     a
     6  0001  210000                ld      hl,__BSS_head
     7  0004  01ffff                ld      bc,__BSS_END_tail - __BSS_head - 1
     8                            IF !__CPU_INTEL__ && !__CPU_GBZ80__
     9  0007  110100                ld      de,__BSS_head + 1
    10  000a  77                    ld      (hl),a
    11  000b  edb0                  ldir
    12                            ELSE
    13                              inc     b
    14                              inc     c
    15                          init_8080:
    16                              ld      (hl+),a
    17                              dec     c
    18                              jr      NZ,init_8080
    19                              dec     b
    20                              jr      NZ,init_8080
    21                            ENDIF
    22                          ENDIF
    23                          
z88dk/lib/crt/classic/crt_section.inc:
    27                          
    28                          
    29                          IF CRT_ENABLE_STDIO = 1 && CLIB_FOPEN_MAX > 0
    30                              ; Setup std* streams
    31  000d  210200                ld      hl,__sgoioblk+2
    32  0010  3612                  ld      (hl),18 ;stdin
    33  0012  210c00                ld      hl,__sgoioblk+12
    34  0015  3614                  ld      (hl),20 ;stdout
    35  0017  211600                ld      hl,__sgoioblk+22
    36  001a  3614                  ld      (hl),20 ;stderr
    37                          ENDIF
    38                              INCLUDE "crt/classic/crt_copy_data_section.inc"
z88dk/lib/crt/classic/crt_copy_data_section.inc:
     1                          ; For ROM compilations copy the data section up into RAM
     2                          
     3                          IF ( __crt_model = 1 )
     4                              ; Just copy the DATA section
     5                              EXTERN  __ROMABLE_END_tail
     6                              EXTERN  __DATA_head
     7                              EXTERN  __DATA_END_tail
     8                              ld      hl,__ROMABLE_END_tail
     9                              ld      de,__DATA_head
    10                              ld      bc,__DATA_END_tail - __DATA_head
    11                            IF __CPU_INTEL__
    12                              EXTERN  asm_memcpy
    13                              call    asm_memcpy
    14                            ELSE
    15                              ldir
    16                            ENDIF
    17                          ELIF ( __crt_model >= 2 )
    18                              EXTERN  __ROMABLE_END_tail
    19                              EXTERN  __DATA_head
    20                              ld      hl,__ROMABLE_END_tail
    21                              ld      de,__DATA_head
    22                            IF ( __crt_model = 2)
    23                              EXTERN  asm_dzx7_standard
    24                              call    asm_dzx7_standard
    25                            ELIF ( __crt_model = 3)
    26                              EXTERN  asm_dzx0_standard
    27                              call    asm_dzx0_standard
    28                            ENDIF
    29                          ENDIF
    30                          
z88dk/lib/crt/classic/crt_section.inc:
