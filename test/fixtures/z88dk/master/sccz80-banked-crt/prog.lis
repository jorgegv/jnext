  6445                          ; ------------------------------------------
  6446                          ; Alternate ROM
  6447                          ; ------------------------------------------
  6448                          ; Bits 7:4 take effect immediately. Bits 3:0 are copied into bits 7:4 on a soft reset
  6449                          
  6450                          defc __REG_ALTERNATE_ROM = 0x8C
  6451                          
  6452                          ; Enable the alternate rom
  6453                          defc __RAR_ENABLE = 0x80
  6454                          
  6455                          ; Make the alternate rom visible only during writes instead of replacing the rom during reads
  6456                          defc __RAR_WRITE_ONLY = 0x40
  6457                          
  6458                          ; Lock ROM1 (the 48K rom) and ROM0 (the 128K rom). Applies even while the alternate rom is disabled
  6459                          defc __RAR_LOCK_ROM1 = 0x20
  6460                          defc __RAR_LOCK_ROM0 = 0x10
  6461                          
  6462                          ; The same settings applied on the next soft reset
  6463                          defc __RAR_ENABLE_ON_SOFT_RESET = 0x08
  6464                          defc __RAR_WRITE_ONLY_ON_SOFT_RESET = 0x04
  6465                          defc __RAR_LOCK_ROM1_ON_SOFT_RESET = 0x02
  6466                          defc __RAR_LOCK_ROM0_ON_SOFT_RESET = 0x01
  6467                          
  6468                          ; ------------------------------------------
  6469                          ; Spectrum 128K memory mapping
  6470                          ; ------------------------------------------
  6471                          ; A single register view of ports 0x7ffd and 0xdffd and 0x1ffd. Writes take
  6472                          ; effect at once as if made through the ports
  6473                          
  6474                          defc __REG_SPECTRUM_128K_MAPPING = 0x8E
  6475                          
  6476                          ; RAM bank 0-15 in bits 7:4 (port 0xdffd bit 0 and port 0x7ffd bits 2:0)
  6477                          defc __RSM_RAM_BANK_MASK = 0xF0
  6478                          
  6479                          ; Write 1 to change the RAM bank. Always reads as 1
  6480                          defc __RSM_CHANGE_RAM_BANK = 0x08
  6481                          
  6482                          ; Paging mode: special all RAM (port 0x1ffd bit 0)
  6483                          defc __RSM_ALL_RAM = 0x04
  6484                          
  6485                          ; ROM select or the all RAM configuration when RSM_ALL_RAM is set (bits 1:0)
  6486                          defc __RSM_ROM_MASK = 0x03
  6487                          defc __RSM_ALL_RAM_MASK = 0x03
  6488                          
  6489                          ; ------------------------------------------
  6490                          ; Memory mapping mode
  6491                          ; ------------------------------------------
  6492                          ; How ports 0x7ffd and 0xdffd and 0x1ffd and 0xeff7 page memory
  6493                          
  6494                          defc __REG_MEMORY_MAPPING_MODE = 0x8F
  6495                          
  6496                          defc __RMMM_ZX_128K_P3 = 0x00
  6497                          defc __RMMM_PENTAGON_512K = 0x02
  6498                          defc __RMMM_PENTAGON_1024K = 0x03
  6499                          
