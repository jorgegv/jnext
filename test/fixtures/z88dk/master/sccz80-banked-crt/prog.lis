   746                          
   747                                      IF (-__crt_org_vector_table) & 0x1f
   748                          
   749                                         "Cannot place __IO_VECTOR_BASE at start of interrupt vector table"
   750                          
   751                                      ELSE
   752                          
   753                                         defc __IO_VECTOR_BASE = (-__crt_org_vector_table) & 0xe0
   754                          
   755                                      ENDIF
   756                          
   757                                   ELSE
   758                          
   759                                      IF __crt_org_vector_table & 0x1f
   760                          
   761                                         "Cannot place __IO_VECTOR_BASE at start of interrupt vector table"
   762                          
   763                                      ELSE
   764                          
   765                                         defc __IO_VECTOR_BASE = __crt_org_vector_table & 0xe0
   766                          
   767                                      ENDIF
   768                          
   769                                   ENDIF
   770                          
   771                                ELSE
   772                          
   773                                   IF __crt_io_vector_base & 0x1f
   774                          
   775                                      "Illegal __IO_VECTOR_BASE"
   776                          
   777                                   ELSE
   778                          
   779                                      defc __IO_VECTOR_BASE = __crt_io_vector_base & 0xe0
   780                          
   781                                   ENDIF
   782                          
   783                                ENDIF
   784                          
   785                             ENDIF
   786                          
   787                          ;; end crt rules ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
