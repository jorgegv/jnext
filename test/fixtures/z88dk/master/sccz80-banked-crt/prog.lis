  5909                          ; --------------------------------------------------------
  5910                          ; Interrupt control status and enable registers
  5911                          ; --------------------------------------------------------
  5912                          
  5913                          ; Selects the maskable interrupt mode and the programmable im2 vector
  5914                          defc __REG_INTERRUPT_CONTROL = 0xC0
  5915                          
  5916                          ; Programmable portion of the im2 vector occupies the three high bits
  5917                          defc __RIC_IM2_VECTOR_MASK = 0xE0
  5918                          
  5919                          ; Enable stackless nmi response
  5920                          defc __RIC_ENABLE_STACKLESS_NMI = 0x08
  5921                          
  5922                          ; Current Z80 interrupt mode (read only) in bits 2:1
  5923                          defc __RIC_Z80_INTERRUPT_MODE_MASK = 0x06
  5924                          
  5925                          ; Maskable interrupt mode: pulse (0) or hardware im2 (1)
  5926                          defc __RIC_MODE_PULSE = 0x00
  5927                          defc __RIC_MODE_HW_IM2 = 0x01
  5928                          
  5929                          ; --------------------------------------------------------
  5930                          ; Interrupt enable registers
  5931                          ; --------------------------------------------------------
  5932                          ; A disabled device interrupt enters a polled mode
  5933                          
  5934                          defc __REG_INTERRUPT_ENABLE_0 = 0xC4
  5935                          defc __REG_INTERRUPT_ENABLE_1 = 0xC5
  5936                          defc __REG_INTERRUPT_ENABLE_2 = 0xC6
  5937                          
  5938                          ; --------------------------------------------------------
  5939                          ; Interrupt status registers
  5940                          ; --------------------------------------------------------
  5941                          ; Reading a set bit means the device generated an interrupt or one is pending
  5942                          ; Writing a set bit clears that status
  5943                          
  5944                          defc __REG_INTERRUPT_STATUS_0 = 0xC8
  5945                          defc __REG_INTERRUPT_STATUS_1 = 0xC9
  5946                          defc __REG_INTERRUPT_STATUS_2 = 0xCA
  5947                          
  5948                          ; --------------------------------------------------------
  5949                          ; DMA interrupt enable registers
  5950                          ; --------------------------------------------------------
  5951                          ; A set bit means the interrupt will interrupt a dma operation in hardware im2 mode
  5952                          
  5953                          defc __REG_DMA_INTERRUPT_ENABLE_0 = 0xCC
  5954                          defc __REG_DMA_INTERRUPT_ENABLE_1 = 0xCD
  5955                          defc __REG_DMA_INTERRUPT_ENABLE_2 = 0xCE
  5956                          
  5957                          ; --------------------------------------------------------
  5958                          ; Bits shared by the group 0 registers above
  5959                          ; --------------------------------------------------------
  5960                          ; Bit 7 is the expansion bus /INT in REG_INTERRUPT_ENABLE_0 and the NMI in
  5961                          ; REG_DMA_INTERRUPT_ENABLE_0. It is reserved in REG_INTERRUPT_STATUS_0
  5962                          
  5963                          defc __RI0_EXPANSION_BUS = 0x80
  5964                          defc __RI0_NMI = 0x80
  5965                          defc __RI0_LINE = 0x02
  5966                          defc __RI0_ULA = 0x01
  5967                          
  5968                          ; --------------------------------------------------------
  5969                          ; Bits shared by the group 1 registers above (CTC channels)
  5970                          ; --------------------------------------------------------
  5971                          
  5972                          defc __RI1_CTC_CHANNEL_0 = 0x01
  5973                          defc __RI1_CTC_CHANNEL_1 = 0x02
  5974                          defc __RI1_CTC_CHANNEL_2 = 0x04
  5975                          defc __RI1_CTC_CHANNEL_3 = 0x08
  5976                          defc __RI1_CTC_CHANNEL_4 = 0x10
  5977                          defc __RI1_CTC_CHANNEL_5 = 0x20
  5978                          defc __RI1_CTC_CHANNEL_6 = 0x40
  5979                          defc __RI1_CTC_CHANNEL_7 = 0x80
  5980                          
  5981                          ; --------------------------------------------------------
  5982                          ; Bits shared by the group 2 registers above (UART)
  5983                          ; --------------------------------------------------------
  5984                          ; The Rx available and Rx near full sources share one interrupt and
  5985                          ; Rx near full overrides Rx available
  5986                          
  5987                          defc __RI2_UART0_RX_AVAILABLE = 0x01
  5988                          defc __RI2_UART0_RX_NEAR_FULL = 0x02
  5989                          defc __RI2_UART0_TX_EMPTY = 0x04
  5990                          defc __RI2_UART1_RX_AVAILABLE = 0x10
  5991                          defc __RI2_UART1_RX_NEAR_FULL = 0x20
  5992                          defc __RI2_UART1_TX_EMPTY = 0x40
  5993                          
  5994                          ; --------------------------------------------------------
  5995                          ; Vertical line count offset
  5996                          ; --------------------------------------------------------
  5997                          
  5998                          ; Offset added to the vertical line counter. It affects the copper the line
  5999                          ; interrupt and the active line count. A change takes up to one frame to occur
  6000                          defc __REG_LINE_INTERRUPT_OFFSET = 0x64
  6001                          
  6002                          ; --------------------------------------------------------
  6003                          ; Generate maskable interrupt
  6004                          ; --------------------------------------------------------
  6005                          ; Reading a set bit means the interrupt occurred or is pending (alias of bits
  6006                          ; in REG_INTERRUPT_STATUS_0 to REG_INTERRUPT_STATUS_2). Writing a set bit
  6007                          ; always generates a maskable interrupt regardless of the enables
  6008                          
  6009                          defc __REG_GENERATE_MASKABLE_INTERRUPT = 0x20
  6010                          
  6011                          defc __RGMI_LINE = 0x80
  6012                          defc __RGMI_ULA = 0x40
  6013                          defc __RGMI_CTC_CHANNEL_0 = 0x01
  6014                          defc __RGMI_CTC_CHANNEL_1 = 0x02
  6015                          defc __RGMI_CTC_CHANNEL_2 = 0x04
  6016                          defc __RGMI_CTC_CHANNEL_3 = 0x08
  6017                          
  6018                          ; --------------------------------------------------------
  6019                          ; NMI return address
  6020                          ; --------------------------------------------------------
  6021                          ; The return address written during an nmi acknowledge cycle is always stored here
  6022                          
  6023                          defc __REG_NMI_RETURN_ADDRESS_L = 0xC2
  6024                          defc __REG_NMI_RETURN_ADDRESS_H = 0xC3
