   794                             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   795                             ; Define Memory Banks
   796                             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   797                          
   798                             ; Bits 16-23 of a BANK or PAGE origin hold the 8K page that banked_call
   799                             ; maps at MMU6, with the page after it at MMU7 (CLIB_BANKING_SEGMENT = 3).
   800                             ; BANK_n, BANK_n_L and BANK_n_H use page 2n.  PAGE_n uses the even page
   801                             ; of its pair, so PAGE_20 is 0x14c000 and PAGE_21 is 0x14e000.
   802                             ; appmake places each bank and page by its section name, not by these bits.
   803                          
   804                          
   805                             IFNDEF CRT_ORG_BANK_0
   806                                defc CRT_ORG_BANK_0 = 0xc000
   807                             ENDIF
   808                          
   809                             IFNDEF CRT_ORG_BANK_0_L
   810                                defc CRT_ORG_BANK_0_L = 0xc000
   811                             ENDIF
