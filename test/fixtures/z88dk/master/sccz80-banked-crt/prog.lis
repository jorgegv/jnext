  5536                          ; ------------------------------------------
  5537                          ; Hardware tilemap (aka layer 3) registers
  5538                          ; ------------------------------------------
  5539                          
  5540                          ; Sets and reads the clip-window for Tilemap graphics
  5541                          defc __REG_CLIP_WINDOW_TILEMAP = 0x1B
  5542                          
  5543                          ; Sets the X pixel offset (two high bits) used for drawing Tilemap graphics on the screen
  5544                          defc __REG_TILEMAP_OFFSET_X_MSB = 0x2f
  5545                          
  5546                          ; Sets the X pixel offset (eight low bits) used for drawing Tilemap graphics on the screen
  5547                          defc __REG_TILEMAP_OFFSET_X_LSB = 0x30
  5548                          
  5549                          ; Sets the Y pixel offset used for drawing Tilemap graphics on the screen
  5550                          defc __REG_TILEMAP_OFFSET_Y = 0x31
  5551                          
  5552                          ; Sets the transparency index for Tilemap graphics
  5553                          defc __REG_TILEMAP_TRANSPARENCY_INDEX = 0x4C
  5554                          
  5555                          ; ----------------------------------------------------------------
  5556                          ; Tilemap values for clip window control (REG_CLIP_WINDOW_CONTROL)
  5557                          ; ----------------------------------------------------------------
  5558                          
  5559                          ; Reset the tilemap clip index
  5560                          defc __RCWC_RESET_TILEMAP_CLIP_INDEX = 0x08
  5561                          
  5562                          ; ------------------------------------------------------------------------
  5563                          ; Tilemap selection for the palette control register (REG_PALETTE_CONTROL)
  5564                          ; ------------------------------------------------------------------------
  5565                          
  5566                          ; Tilemap first palette
  5567                          defc __RPC_SELECT_TILEMAP_PALETTE_0 = 0x30
  5568                          
  5569                          ; Tilemap second palette
  5570                          defc __RPC_SELECT_TILEMAP_PALETTE_1 = 0x70
  5571                          
  5572                          ; ------------------------------------------
  5573                          ; Tilemap control register and flags
  5574                          ; ------------------------------------------
  5575                          
  5576                          ; Controls the tilemap mode and enables it
  5577                          defc __REG_TILEMAP_CONTROL = 0x6B
  5578                          
  5579                          ; Enable the tilemap
  5580                          defc __RTC_ENABLE_TILEMAP = 0x80
  5581                          
  5582                          ; Tilemap size: 40x32 (default) or 80x32
  5583                          defc __RTC_40x32_MODE = 0x00
  5584                          defc __RTC_80x32_MODE = 0x40
  5585                          
  5586                          ; Eliminate the attribute entry in the tilemap
  5587                          defc __RTC_ELIMINATE_ATTRIBUTE_BYTE = 0x20
  5588                          
  5589                          ; Palette select: first (default) or second tilemap palette
  5590                          defc __RTC_SELECT_PALETTE_0 = 0x00
  5591                          defc __RTC_SELECT_PALETTE_1 = 0x10
  5592                          
  5593                          ; Select textmode
  5594                          defc __RTC_ACTIVATE_TEXT_MODE = 0x08
  5595                          
  5596                          ; Activate 512 tile mode
