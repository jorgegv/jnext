  6257                          ; ------------------------------------------
  6258                          ; Expansion bus enable
  6259                          ; ------------------------------------------
  6260                          ; Bits 7:4 take effect immediately. Bits 3:0 are copied into bits 7:4 on a soft reset
  6261                          
  6262                          defc __REG_EXPANSION_BUS_ENABLE = 0x80
  6263                          
  6264                          ; Enable the expansion bus
  6265                          defc __REBE_ENABLE = 0x80
  6266                          
  6267                          ; Enable romcs rom replacement from divmmc banks 14 and 15
  6268                          defc __REBE_ENABLE_ROMCS_REPLACEMENT = 0x40
  6269                          
  6270                          ; Disable i/o cycles and ignore iorqula
  6271                          defc __REBE_DISABLE_IO_CYCLES = 0x20
  6272                          
  6273                          ; Disable memory cycles and ignore romcs
  6274                          defc __REBE_DISABLE_MEMORY_CYCLES = 0x10
  6275                          
  6276                          ; The same settings applied on the next soft reset
  6277                          defc __REBE_ENABLE_ON_SOFT_RESET = 0x08
  6278                          defc __REBE_ENABLE_ROMCS_REPLACEMENT_ON_SOFT_RESET = 0x04
  6279                          defc __REBE_DISABLE_IO_CYCLES_ON_SOFT_RESET = 0x02
  6280                          defc __REBE_DISABLE_MEMORY_CYCLES_ON_SOFT_RESET = 0x01
  6281                          
  6282                          ; ------------------------------------------
  6283                          ; Expansion bus control
  6284                          ; ------------------------------------------
  6285                          
  6286                          defc __REG_EXPANSION_BUS_CONTROL = 0x81
  6287                          
  6288                          ; ROMCS is asserted on the expansion bus (read only)
  6289                          defc __REBC_ROMCS_ASSERTED = 0x80
  6290                          
  6291                          ; Allow peripherals to override the ULA on some even port reads (Rotronics Wafadrive)
  6292                          defc __REBC_ALLOW_ULA_OVERRIDE = 0x40
  6293                          
  6294                          ; Disable the expansion bus nmi debounce (Opus Discovery)
  6295                          defc __REBC_DISABLE_NMI_DEBOUNCE = 0x20
  6296                          
  6297                          ; Propagate the max cpu clock at all times including when the expansion bus is off
  6298                          defc __REBC_PROPAGATE_MAX_CPU_CLOCK = 0x10
  6299                          
  6300                          ; Enable +3 fdc signals on the expansion bus (issue 5 only)
  6301                          defc __REBC_ENABLE_P3_FDC_SIGNALS = 0x08
  6302                          
  6303                          ; Max cpu speed while the expansion bus is on (bits 1:0 and currently fixed at 3.5MHz)
  6304                          defc __REBC_MAX_CPU_SPEED_MASK = 0x03
  6305                          defc __REBC_MAX_CPU_SPEED_3MHZ = 0x00
  6306                          
  6307                          ; --------------------------------------------------------
  6308                          ; Port decoding enables
  6309                          ; --------------------------------------------------------
  6310                          ; Two 32-bit registers with the least significant byte first. A clear bit
  6311                          ; disables the internal device. The internal enables always apply. While the
  6312                          ; expansion bus is on the expansion bus enables are ANDed with them and io
  6313                          ; cycles to a disabled port propagate to the expansion bus
  6314                          
  6315                          defc __REG_INTERNAL_PORT_DECODING_0 = 0x82
  6316                          defc __REG_INTERNAL_PORT_DECODING_1 = 0x83
  6317                          defc __REG_INTERNAL_PORT_DECODING_2 = 0x84
  6318                          defc __REG_INTERNAL_PORT_DECODING_3 = 0x85
  6319                          
  6320                          defc __REG_EXPANSION_BUS_DECODING_0 = 0x86
  6321                          defc __REG_EXPANSION_BUS_DECODING_1 = 0x87
  6322                          defc __REG_EXPANSION_BUS_DECODING_2 = 0x88
  6323                          defc __REG_EXPANSION_BUS_DECODING_3 = 0x89
  6324                          
  6325                          ; Bits of REG_INTERNAL_PORT_DECODING_0 and REG_EXPANSION_BUS_DECODING_0
  6326                          defc __RPD0_PORT_FF = 0x01
  6327                          defc __RPD0_PORT_7FFD = 0x02
  6328                          defc __RPD0_PORT_DFFD = 0x04
  6329                          defc __RPD0_PORT_1FFD = 0x08
  6330                          defc __RPD0_P3_FLOATING_BUS = 0x10
  6331                          defc __RPD0_ZXN_DMA = 0x20
  6332                          defc __RPD0_KEMPSTON_1 = 0x40
  6333                          defc __RPD0_KEMPSTON_2 = 0x80
  6334                          
  6335                          ; Bits of REG_INTERNAL_PORT_DECODING_1 and REG_EXPANSION_BUS_DECODING_1
  6336                          defc __RPD1_DIVMMC = 0x01
  6337                          defc __RPD1_MULTIFACE = 0x02
  6338                          defc __RPD1_I2C = 0x04
  6339                          defc __RPD1_SPI = 0x08
  6340                          defc __RPD1_UART = 0x10
  6341                          defc __RPD1_MOUSE = 0x20
  6342                          defc __RPD1_SPRITES = 0x40
  6343                          defc __RPD1_LAYER_2 = 0x80
  6344                          
  6345                          ; Bits of REG_INTERNAL_PORT_DECODING_2 and REG_EXPANSION_BUS_DECODING_2
  6346                          defc __RPD2_AY = 0x01
  6347                          defc __RPD2_DAC_SOUNDRIVE_1 = 0x02
  6348                          defc __RPD2_DAC_SOUNDRIVE_2 = 0x04
  6349                          defc __RPD2_DAC_STEREO_PROFI_COVOX = 0x08
  6350                          defc __RPD2_DAC_STEREO_COVOX = 0x10
  6351                          defc __RPD2_DAC_MONO_PENTAGON_ATM = 0x20
  6352                          defc __RPD2_DAC_MONO_GS_COVOX = 0x40
  6353                          defc __RPD2_DAC_MONO_SPECDRUM = 0x80
  6354                          
  6355                          ; Bits of REG_INTERNAL_PORT_DECODING_3 and REG_EXPANSION_BUS_DECODING_3
  6356                          defc __RPD3_ULA_PLUS = 0x01
  6357                          defc __RPD3_Z80_DMA = 0x02
  6358                          defc __RPD3_PENTAGON_1024 = 0x04
  6359                          defc __RPD3_CTC = 0x08
  6360                          
  6361                          ; Register reset mode: selects whether these registers are set on a soft or a hard reset
  6362                          defc __RPD3_REGISTER_RESET_MODE = 0x80
  6363                          
  6364                          ; ------------------------------------------
  6365                          ; Expansion bus io propagate
  6366                          ; ------------------------------------------
  6367                          ; While the expansion bus is on the io cycles for the selected ports are also
  6368                          ; sent to the bus so external peripherals can follow the internal state. Values read
  6369                          ; from the bus on port 0xfe are mixed into keyboard reads
  6370                          
  6371                          defc __REG_EXPANSION_BUS_IO_PROPAGATE = 0x8A
  6372                          
  6373                          defc __REBIP_PORT_EFF7 = 0x20
