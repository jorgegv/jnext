  3481                          
  3482                             ; banked calls configuration
  3483                             ; MMU Next register to be used for banked calls depends on the value of CLIB_BANKING_SEGMENT:
  3484                             ;   0: MMU 0 and 1
  3485                             ;   1: MMU 2 and 3
  3486                             ;   2: MMU 4 and 5
  3487                             ;   3: MMU 6 and 7
  3488                             ;
  3489                             ; banked_call maps new pages into this segment, so the stack must be
  3490                             ; outside it.  The default stack (0xff58) is in MMU 7: with the default
  3491                             ; segment, move it below 0xc000, e.g. -pragma-define:REGISTER_SP=0xc000.
  3492                             ; With another segment, also give each bank or page that holds banked
  3493                             ; functions an origin in that segment, with the page in bits 16-23.
  3494                          
  3495                             PUBLIC CLIB_BANKING_SEGMENT
  3496                          
  3497                             IFNDEF CLIB_BANKING_SEGMENT
  3498                                defc CLIB_BANKING_SEGMENT = 3
  3499                             ENDIF
  3500                          
  3501                             PUBLIC CLIB_BANKING_STACK_SIZE
  3502                          
  3503                             IFNDEF CLIB_BANKING_STACK_SIZE
  3504                                defc CLIB_BANKING_STACK_SIZE = 100
  3505                             ENDIF
  3506                          
  3507                             ;
  3508                             ; FONT SELECTION
  3509                             ; use pragam redirect to change font
  3510                             ;
  3511                             ; #pragam redirect CRT_OTERM_FONT_8X8 = _font_8x8_rom        ; 32-col font definition in rom
  3512                             ; #pragma redirect CRT_OTERM_FONT_8X8 = _font_8x8_zx_system  ; 32-col font, timex hi-res 64-col font
  3513                             ; #pragma redirect CRT_OTERM_FONT_4X8 = _font_4x8_default    ; 64-col font, timex hi-res 128-col font
  3514                             ; #pragma redirect CRT_OTERM_FONT_FZX = _ff_ind_Termino      ; fzx proportional font
  3515                          
  3516                          ;; end crt rules ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
