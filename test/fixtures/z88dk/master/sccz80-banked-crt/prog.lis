  8808                          
  8809                          
  8810                          ; When FILEs and FDSTRUCTs are instantiated labels are assigned
  8811                          ; to point at created structures.
  8812                          ;
  8813                          ; The label formats are:
  8814                          ;
  8815                          ; __i_stdio_file_n     = address of static FILE structure #n (0..__I_STDIO_NUM_FILE-1)
  8816                          ; __i_fcntl_fdstruct_n = address of static FDSTRUCT #n (0..__I_FCNTL_NUM_FD-1)
  8817                          ; __i_fcntl_heap_n     = address of allocation #n on heap (0..__I_FCNTL_NUM_HEAP-1)
  8818                          
  8819                          
  8820                          
  8821                          
  8822                          
  8823                          
  8824                             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  8825                             ; FILE  : _stdin
  8826                             ;
  8827                             ; driver: zx_01_input_kbd_inkey
  8828                             ; fd    : 0
  8829                             ; mode  : read only
  8830                             ; type  : 001 = input terminal
  8831                             ; tie   : __i_fcntl_fdstruct_1
  8832                             ;
  8833                             ; ioctl_flags   : CRT_ITERM_TERMINAL_FLAGS
  8834                             ; buffer size   : 64 bytes
  8835                             ; debounce      : CRT_ITERM_INKEY_DEBOUNCE ms
  8836                             ; repeat_start  : CRT_ITERM_INKEY_REPEAT_START ms
  8837                             ; repeat_period : CRT_ITERM_INKEY_REPEAT_RATE ms
  8838                             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  8839                          
  8840                          
  8841                             SECTION data_clib
  8842                             SECTION data_stdio
  8843                          
  8844                             ; FILE *
  8845                          
  8846                             PUBLIC _stdin
  8847                          
  8848  0000  0400                 _stdin:  defw __i_stdio_file_0 + 2
  8849                          
  8850                             ; FILE structure
  8851                          
  8852                             __i_stdio_file_0:
  8853                          
  8854                                ; open files link
  8855                          
  8856  0002  0000                    defw 0
  8857                          
  8858                                ; jump to underlying fd
  8859                          
  8860  0004  c3                      defb 195
  8861  0005  0600                    defw __i_fcntl_fdstruct_0
  8862                          
  8863                                ; state_flags_0
  8864                                ; state_flags_1
  8865                                ; conversion flags
  8866                                ; ungetc
  8867                          
  8868  0007  40                      defb 0x40      ; read + stdio manages ungetc + normal file type
  8869  0008  02                      defb 0x02      ; last operation was read
  8870  0009  00                      defb 0
  8871  000a  00                      defb 0
  8872                          
  8873                                ; mtx_recursive
  8874                          
  8875  000b  00                      defb 0         ; thread owner = none
  8876  000c  02                      defb 0x02      ; mtx_recursive
  8877  000d  00                      defb 0         ; lock count = 0
  8878  000e  fe                      defb 0xfe      ; atomic spinlock
  8879  000f  0000                    defw 0         ; list of blocked threads
  8880                          
  8881                          
  8882                             ; fd table entry
  8883                          
  8884                             SECTION data_fcntl_fdtable_body
  8885  0000  0600                 defw __i_fcntl_fdstruct_0
  8886                          
  8887                             ; FDSTRUCT structure
  8888                          
  8889                             SECTION data_fcntl_stdio_heap_body
  8890                          
  8891                             EXTERN console_01_input_terminal_fdriver
  8892                             EXTERN zx_01_input_kbd_inkey
  8893                          
  8894                             __i_fcntl_heap_0:
  8895                          
  8896                                ; heap header
  8897                          
  8898  0000  6900                    defw __i_fcntl_heap_1
  8899  0002  6900                    defw 105
  8900  0004  0000                    defw 0
  8901                          
  8902                             __i_fcntl_fdstruct_0:
  8903                          
  8904                                ; FDSTRUCT structure
  8905                          
  8906                                ; call to first entry to driver
  8907                          
  8908  0006  cd                      defb 205
  8909  0007  0000                    defw console_01_input_terminal_fdriver
  8910                          
  8911                                ; jump to driver
  8912                          
  8913  0009  c3                      defb 195
  8914  000a  0000                    defw zx_01_input_kbd_inkey
  8915                          
  8916                                ; flags
  8917                                ; reference_count
  8918                                ; mode_byte
  8919                          
  8920  000c  01                      defb 0x01      ; stdio handles ungetc + type = input terminal
  8921  000d  02                      defb 2
  8922  000e  01                      defb 0x01      ; read only
  8923                          
  8924                                ; ioctl_flags
  8925                          
  8926  000f  b003                    defw CRT_ITERM_TERMINAL_FLAGS
  8927                          
  8928                                ; mtx_plain
  8929                          
  8930  0011  00                      defb 0         ; thread owner = none
  8931  0012  01                      defb 0x01      ; mtx_plain
  8932  0013  00                      defb 0         ; lock count = 0
  8933  0014  fe                      defb 0xfe      ; atomic spinlock
  8934  0015  0000                    defw 0         ; list of blocked threads
  8935                          
  8936                                ; tied output terminal
  8937                                ; pending_char
  8938                                ; read_index
  8939                          
  8940  0017  6f00                    defw __i_fcntl_fdstruct_1
  8941  0019  00                      defb 0
  8942  001a  0000                    defw 0
  8943                          
  8944                                ; b_array_t edit_buffer
  8945                          
  8946  001c  2900                    defw __edit_buffer_0
  8947  001e  0000                    defw 0
  8948  0020  4000                    defw 64
  8949                          
  8950                                ; getk_state
  8951                                ; getk_lastk
  8952                                ; getk_debounce_ms
  8953                                ; getk_repeatbegin_ms
  8954                                ; getk_repeatperiod_ms
  8955                          
  8956  0022  00                      defb 0
  8957  0023  00                      defb 0
  8958  0024  01                      defb CRT_ITERM_INKEY_DEBOUNCE
  8959  0025  f401                    defw CRT_ITERM_INKEY_REPEAT_START
  8960  0027  0f00                    defw CRT_ITERM_INKEY_REPEAT_RATE
  8961                          
  8962                          
  8963                                ; reserve space for edit buffer
  8964                          
  8965  0029  0000000000000000        __edit_buffer_0:   defs 64
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
  8966                          
  8967                          
  8968                          
  8969                             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  8970                          
  8971                          
  8972                          
  8973                             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  8974                             ; FILE  : _stdout
  8975                             ;
  8976                             ; driver: zx_01_output_char_32
  8977                             ; fd    : 1
  8978                             ; mode  : write only
  8979                             ; type  : 002 = output terminal
  8980                             ;
  8981                             ; ioctl_flags   : CRT_OTERM_TERMINAL_FLAGS
  8982                             ; cursor coord  : (0,0)
  8983                             ; window        : (CRT_OTERM_WINDOW_X,CRT_OTERM_WINDOW_WIDTH,CRT_OTERM_WINDOW_Y,CRT_OTERM_WINDOW_HEIGHT)
  8984                             ; scroll limit  : 0
  8985                             ; font address  : CRT_OTERM_FONT_8X8
  8986                             ; text colour   : CRT_OTERM_TEXT_COLOR
  8987                             ; text mask     : CRT_OTERM_TEXT_COLOR_MASK
  8988                             ; background    : CRT_OTERM_BACKGROUND_COLOR
  8989                             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  8990                          
  8991                          
  8992                             SECTION data_clib
  8993                             SECTION data_stdio
  8994                          
  8995                             ; FILE *
  8996                          
  8997                             PUBLIC _stdout
  8998                          
  8999  0011  1500                 _stdout:  defw __i_stdio_file_1 + 2
  9000                          
  9001                             ; FILE structure
  9002                          
  9003                             __i_stdio_file_1:
  9004                          
  9005                                ; open files link
  9006                          
  9007  0013  0200                    defw __i_stdio_file_0
  9008                          
  9009                                ; jump to underlying fd
  9010                          
