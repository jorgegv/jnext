  8798                          ;; INSTANTIATE DRIVERS ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  8799                          ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  8800                          
  8801                          ifndef CRT_OTERM_FONT_8X8
  8802                          
  8803                             PUBLIC CRT_OTERM_FONT_8X8
  8804                             EXTERN _font_8x8_rom
