  6153                          
  6154                          ; Multiface type mouse dpi and mouse button order
  6155                          defc __REG_PERIPHERAL_5 = 0x0A
  6156                          
  6157                          ; Multiface type (bits 7:6) (config mode only)
  6158                          defc __RP5_MULTIFACE_P3 = 0x00
  6159                          defc __RP5_MULTIFACE_128_V87_2 = 0x40
  6160                          defc __RP5_MULTIFACE_128_V87_12 = 0x80
  6161                          defc __RP5_MULTIFACE_1 = 0xC0
  6162                          
  6163                          ; Swap sd0 and sd1 (config mode only)
  6164                          defc __RP5_SWAP_SD0_SD1 = 0x20
  6165                          
  6166                          ; Enable divmmc automap
  6167                          defc __RP5_ENABLE_DIVMMC_AUTOMAP = 0x10
  6168                          
  6169                          ; Reverse the left and right mouse buttons
  6170                          defc __RP5_MOUSE_REVERSE_BUTTONS = 0x08
