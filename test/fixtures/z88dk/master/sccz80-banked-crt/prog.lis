  6183                          ; via the Kempston ports
  6184                          
  6185                          defc __REG_JOYSTICK_IO_MODE = 0x0B
  6186                          
  6187                          ; Enable i/o mode
  6188                          defc __RJIM_ENABLE_IO_MODE = 0x80
  6189                          
  6190                          ; I/O mode (bits 5:4)
  6191                          defc __RJIM_MODE_BIT_BANG = 0x00
  6192                          defc __RJIM_MODE_CLOCK = 0x10
  6193                          defc __RJIM_MODE_UART_LEFT_PORT = 0x20
  6194                          defc __RJIM_MODE_UART_RIGHT_PORT = 0x30
  6195                          
  6196                          ; Mode parameter. Bit bang mode: pin 7 state. Clock mode: run the clock.
  6197                          ; Uart mode: redirect the pi uart1 (1) instead of the esp uart0 (0)
  6198                          defc __RJIM_PARAMETER = 0x01
