  3154                                defc DOTN_LAST_PAGE = __ZXNEXT_LAST_PAGE
  3155                             ENDIF
  3156                          
  3157                             IF DOTN_LAST_PAGE < 11
  3158                                error "DOTN_LAST_PAGE must be at least 11"
  3159                             ELSE
