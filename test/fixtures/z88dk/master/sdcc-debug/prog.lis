  6223                          ; ------------------------------------------
  6224                          ; DAC mirror registers
  6225                          ; ------------------------------------------
  6226                          ; Writing sends an 8-bit sample to the corresponding side. Reading returns the
  6227                          ; MSB of the current I2S sample whose LSB is latched into REG_DAC_MONO (0x2D)
  6228                          ; These registers let the copper drive the stereo DACs
  6229                          
  6230                          ; 8-bit sample written to the left side DAC B
  6231                          defc __REG_DAC_LEFT = 0x2C
  6232                          
  6233                          ; 8-bit sample written to the right side DAC C
  6234                          defc __REG_DAC_RIGHT = 0x2E
  6235                          
  6236                          
  6237                          PUBLIC __REG_DAC_LEFT
  6238                          PUBLIC __REG_DAC_RIGHT
  6239                          
  6240                          
  6241                          
  6242                          ; ------------------------------------------
  6243                          ; Copper 16-bit data write
  6244                          ; ------------------------------------------
  6245                          ; Values are written in pairs: first the MSB for an even copper address and
  6246                          ; then the LSB for an odd copper address. The whole 16-bit instruction is
  6247                          ; stored at once after the LSB is written. The copper address auto-increments
  6248                          ; after each write
  6249                          
  6250                          defc __REG_COPPER_DATA_16 = 0x63
  6251                          
  6252                          
  6253                          PUBLIC __REG_COPPER_DATA_16
  6254                          
  6255                          
