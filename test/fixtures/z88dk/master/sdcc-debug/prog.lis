  8781                          
  8782                          ; When FILEs and FDSTRUCTs are instantiated labels are assigned
  8783                          ; to point at created structures.
  8784                          ;
  8785                          ; The label formats are:
  8786                          ;
  8787                          ; __i_stdio_file_n     = address of static FILE structure #n (0..__I_STDIO_NUM_FILE-1)
  8788                          ; __i_fcntl_fdstruct_n = address of static FDSTRUCT #n (0..__I_FCNTL_NUM_FD-1)
  8789                          ; __i_fcntl_heap_n     = address of allocation #n on heap (0..__I_FCNTL_NUM_HEAP-1)
  8790                          
  8791                          
  8792                          
  8793                          
  8794                          
  8795                          
  8796                             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  8797                             ; FILE  : _stdin
  8798                             ;
  8799                             ; driver: zx_01_input_kbd_inkey
  8800                             ; fd    : 0
  8801                             ; mode  : read only
  8802                             ; type  : 001 = input terminal
  8803                             ; tie   : __i_fcntl_fdstruct_1
  8804                             ;
  8805                             ; ioctl_flags   : CRT_ITERM_TERMINAL_FLAGS
  8806                             ; buffer size   : 64 bytes
  8807                             ; debounce      : CRT_ITERM_INKEY_DEBOUNCE ms
  8808                             ; repeat_start  : CRT_ITERM_INKEY_REPEAT_START ms
  8809                             ; repeat_period : CRT_ITERM_INKEY_REPEAT_RATE ms
  8810                             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
  8811                          
  8812                          
  8813                             SECTION data_clib
  8814                             SECTION data_stdio
  8815                          
  8816                             ; FILE *
  8817                          
  8818                             PUBLIC _stdin
  8819                          
  8820  0000  0400                 _stdin:  defw __i_stdio_file_0 + 2
  8821                          
  8822                             ; FILE structure
  8823                          
  8824                             __i_stdio_file_0:
  8825                          
  8826                                ; open files link
  8827                          
  8828  0002  0000                    defw 0
  8829                          
  8830                                ; jump to underlying fd
  8831                          
  8832  0004  c3                      defb 195
  8833  0005  0600                    defw __i_fcntl_fdstruct_0
  8834                          
  8835                                ; state_flags_0
  8836                                ; state_flags_1
  8837                                ; conversion flags
  8838                                ; ungetc
  8839                          
  8840  0007  40                      defb 0x40      ; read + stdio manages ungetc + normal file type
  8841  0008  02                      defb 0x02      ; last operation was read
  8842  0009  00                      defb 0
  8843  000a  00                      defb 0
  8844                          
  8845                                ; mtx_recursive
  8846                          
  8847  000b  00                      defb 0         ; thread owner = none
  8848  000c  02                      defb 0x02      ; mtx_recursive
  8849  000d  00                      defb 0         ; lock count = 0
  8850  000e  fe                      defb 0xfe      ; atomic spinlock
  8851  000f  0000                    defw 0         ; list of blocked threads
  8852                          
  8853                          
  8854                             ; fd table entry
  8855                          
  8856                             SECTION data_fcntl_fdtable_body
  8857  0000  0600                 defw __i_fcntl_fdstruct_0
  8858                          
  8859                             ; FDSTRUCT structure
  8860                          
  8861                             SECTION data_fcntl_stdio_heap_body
  8862                          
  8863                             EXTERN console_01_input_terminal_fdriver
  8864                             EXTERN zx_01_input_kbd_inkey
  8865                          
  8866                             __i_fcntl_heap_0:
  8867                          
  8868                                ; heap header
  8869                          
  8870  0000  6900                    defw __i_fcntl_heap_1
  8871  0002  6900                    defw 105
  8872  0004  0000                    defw 0
  8873                          
  8874                             __i_fcntl_fdstruct_0:
  8875                          
  8876                                ; FDSTRUCT structure
  8877                          
  8878                                ; call to first entry to driver
  8879                          
  8880  0006  cd                      defb 205
  8881  0007  0000                    defw console_01_input_terminal_fdriver
  8882                          
  8883                                ; jump to driver
  8884                          
  8885  0009  c3                      defb 195
  8886  000a  0000                    defw zx_01_input_kbd_inkey
  8887                          
  8888                                ; flags
  8889                                ; reference_count
  8890                                ; mode_byte
  8891                          
  8892  000c  01                      defb 0x01      ; stdio handles ungetc + type = input terminal
  8893  000d  02                      defb 2
  8894  000e  01                      defb 0x01      ; read only
  8895                          
  8896                                ; ioctl_flags
  8897                          
  8898  000f  b003                    defw CRT_ITERM_TERMINAL_FLAGS
  8899                          
  8900                                ; mtx_plain
  8901                          
  8902  0011  00                      defb 0         ; thread owner = none
  8903  0012  01                      defb 0x01      ; mtx_plain
  8904  0013  00                      defb 0         ; lock count = 0
  8905  0014  fe                      defb 0xfe      ; atomic spinlock
  8906  0015  0000                    defw 0         ; list of blocked threads
  8907                          
  8908                                ; tied output terminal
  8909                                ; pending_char
  8910                                ; read_index
  8911                          
  8912  0017  6f00                    defw __i_fcntl_fdstruct_1
  8913  0019  00                      defb 0
  8914  001a  0000                    defw 0
  8915                          
  8916                                ; b_array_t edit_buffer
  8917                          
  8918  001c  2900                    defw __edit_buffer_0
  8919  001e  0000                    defw 0
  8920  0020  4000                    defw 64
  8921                          
  8922                                ; getk_state
  8923                                ; getk_lastk
  8924                                ; getk_debounce_ms
  8925                                ; getk_repeatbegin_ms
  8926                                ; getk_repeatperiod_ms
  8927                          
  8928  0022  00                      defb 0
  8929  0023  00                      defb 0
  8930  0024  01                      defb CRT_ITERM_INKEY_DEBOUNCE
  8931  0025  f401                    defw CRT_ITERM_INKEY_REPEAT_START
  8932  0027  0f00                    defw CRT_ITERM_INKEY_REPEAT_RATE
  8933                          
  8934                          
  8935                                ; reserve space for edit buffer
  8936                          
  8937  0029  0000000000000000        __edit_buffer_0:   defs 64
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
              0000000000000000  
