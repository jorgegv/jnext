  5784                          ; ------------------------------------------
  5785                          ; ULA control and display control registers
  5786                          ; ------------------------------------------
  5787                          
  5788                          ; Controls the ULA output and how it is blended with the tilemap
  5789                          defc __REG_ULA_CONTROL = 0x68
  5790                          
  5791                          ; Disable the ULA output
  5792                          defc __RUC_DISABLE_ULA_OUTPUT = 0x80
  5793                          
  5794                          ; Blending in SLU modes 6 and 7 (bits 6:5)
  5795                          defc __RUC_ULA_AS_BLEND_COLOR = 0x00
  5796                          defc __RUC_NO_BLENDING = 0x20
  5797                          defc __RUC_ULA_TILEMAP_MIX_AS_BLEND_COLOR = 0x40
  5798                          defc __RUC_TILEMAP_AS_BLEND_COLOR = 0x60
  5799                          
  5800                          ; Cancel entries in the 8x5 matrix for the extended keys
  5801                          defc __RUC_CANCEL_EXTENDED_KEYS_IN_MATRIX = 0x10
  5802                          
  5803                          ; Enable ULA+
  5804                          defc __RUC_ENABLE_ULA_PLUS = 0x08
  5805                          
  5806                          ; ULA half pixel scroll
  5807                          defc __RUC_HALF_PIXEL_SCROLL = 0x04
  5808                          
  5809                          ; Enable stencil mode when both the ULA and the tilemap are enabled
  5810                          defc __RUC_ENABLE_STENCIL_MODE = 0x01
  5811                          
  5812                          ; ------------------------------------------
  5813                          ; Display control 1
  5814                          ; ------------------------------------------
  5815                          
  5816                          ; Enables layer 2 and the ULA shadow display and aliases the Timex display modes
  5817                          defc __REG_DISPLAY_CONTROL = 0x69
  5818                          
  5819                          ; Enable layer 2 (alias of port 0x123B bit 1)
  5820                          defc __RDC_ENABLE_LAYER_2 = 0x80
  5821                          
  5822                          ; Enable the ULA shadow display (alias of port 0x7FFD bit 3)
  5823                          defc __RDC_ENABLE_ULA_SHADOW_DISPLAY = 0x40
  5824                          
  5825                          ; Timex display mode bits (alias of port 0xFF bits 5:0)
  5826                          defc __RDC_TIMEX_DISPLAY_MODE_MASK = 0x3F
  5827                          
  5828                          ; ------------------------------------------
  5829                          ; ULA scroll
  5830                          ; ------------------------------------------
  5831                          
  5832                          ; ULA X offset (0-255)
  5833                          defc __REG_ULA_OFFSET_X = 0x26
  5834                          
  5835                          ; ULA Y offset (0-191)
  5836                          defc __REG_ULA_OFFSET_Y = 0x27
  5837                          
  5838                          ; ------------------------------------------
  5839                          ; LoRes control
  5840                          ; ------------------------------------------
  5841                          
  5842                          defc __REG_LORES_CONTROL = 0x6A
  5843                          
  5844                          ; LoRes is Radastan mode: 128x96x4 in 6144 bytes
  5845                          defc __RLC_RADASTAN_MODE = 0x20
  5846                          
  5847                          ; Radastan Timex display file xor
  5848                          defc __RLC_RADASTAN_TIMEX_XOR = 0x10
  5849                          
  5850                          ; Palette offset occupies the four low bits (only bits 1:0 apply in ULA+ mode)
  5851                          defc __RLC_PALETTE_OFFSET_MASK = 0x0F
  5852                          
