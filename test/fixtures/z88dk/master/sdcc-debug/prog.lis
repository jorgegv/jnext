  3161                                   error "DOTN_LAST_PAGE cannot exceed 223"
  3162                                ELSE
  3163                                   defc __DOTN_LAST_PAGE = DOTN_LAST_PAGE
  3164                                ENDIF
  3165                             ENDIF
