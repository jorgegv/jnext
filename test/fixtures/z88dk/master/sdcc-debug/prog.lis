    27                             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    28                             ;; dynamically generated functions
    29                             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    30                          
    31                             ; dynamic printf
    32                             ;
    33                             ; An explicit CLIB_OPT_PRINTF replaces the library dispatcher.
    34                             ; The compilers record scanned literals as CRT_printf_format.
    35                             ; When that mask names a float converter the library was built
    36                             ; without, rebuild vfprintf as the library mask OR the scan.
    37                             ; An integer program keeps the prebuilt object.
    38                          
    39                             IFNDEF CLIB_OPT_PRINTF
    40                                IFDEF __CLIB_OPT_PRINTF
    41                                   IFDEF CRT_printf_format
    42                                      ; $3fc00000 is %a %A %e %E %f %F %g %G. Width and precision
    43                                      ; ride along in the OR, but they do not rebuild by themselves.
    44                                      IF (CRT_printf_format & $3fc00000) != (__CLIB_OPT_PRINTF & $3fc00000)
    45                                         defc CLIB_OPT_PRINTF = __CLIB_OPT_PRINTF | CRT_printf_format
    46                                         IFNDEF CLIB_OPT_PRINTF_2
    47                                            IFDEF __CLIB_OPT_PRINTF_2
    48                                               defc CLIB_OPT_PRINTF_2 = __CLIB_OPT_PRINTF_2
    49                                            ENDIF
    50                                         ENDIF
    51                                      ENDIF
    52                                   ENDIF
    53                                ENDIF
    54                             ENDIF
    55                          
    56                             IFNDEF CLIB_OPT_PRINTF
    57                                IFDEF CLIB_OPT_PRINTF_2
    58                                   defc CLIB_OPT_PRINTF = 0
    59                                ENDIF
    60                             ENDIF
    61                          
    62                             IFNDEF CLIB_OPT_PRINTF_2
    63                                IFDEF CLIB_OPT_PRINTF
    64                                   defc CLIB_OPT_PRINTF_2 = 0
    65                                ENDIF
    66                             ENDIF
    67                          
    68                             IFDEF CLIB_OPT_PRINTF
    69                          
    70                                IF __SDCC_IY
    71                          
    72                                   ; path from lib/crt/newlib → libsrc/newlib/stdio (post-#2814 layout)
    73                                   INCLUDE "../libsrc/newlib/stdio/z80/asm_vfprintf_unlocked_iy.asm"
    74                          
    75                                ELSE
    76                          
    77                                   INCLUDE "../libsrc/newlib/stdio/z80/asm_vfprintf_unlocked.asm"
    78                          
    79                                ENDIF
    80                          
    81                             ENDIF
    82                          
    83                             ; dynamic scanf
    84                             ;
    85                             ; Same rule as printf. CRT_scanf_format is the scanned literal mask.
    86                          
    87                             IFNDEF CLIB_OPT_SCANF
    88                                IFDEF __CLIB_OPT_SCANF
    89                                   IFDEF CRT_scanf_format
    90                                      IF (CRT_scanf_format & $3fc00000) != (__CLIB_OPT_SCANF & $3fc00000)
    91                                         defc CLIB_OPT_SCANF = __CLIB_OPT_SCANF | CRT_scanf_format
    92                                         IFNDEF CLIB_OPT_SCANF_2
    93                                            IFDEF __CLIB_OPT_SCANF_2
    94                                               defc CLIB_OPT_SCANF_2 = __CLIB_OPT_SCANF_2
    95                                            ENDIF
    96                                         ENDIF
    97                                      ENDIF
    98                                   ENDIF
    99                                ENDIF
   100                             ENDIF
   101                          
   102                             IFNDEF CLIB_OPT_SCANF
   103                                IFDEF CLIB_OPT_SCANF_2
   104                                   defc CLIB_OPT_SCANF = 0
   105                                ENDIF
   106                             ENDIF
   107                          
   108                             IFNDEF CLIB_OPT_SCANF_2
   109                                IFDEF CLIB_OPT_SCANF
   110                                   defc CLIB_OPT_SCANF_2 = 0
   111                                ENDIF
   112                             ENDIF
   113                          
   114                             IFDEF CLIB_OPT_SCANF
   115                          
   116                                IF __SDCC_IY
   117                          
   118                                   INCLUDE "../libsrc/newlib/stdio/z80/asm_vfscanf_unlocked_iy.asm"
   119                          
   120                                ELSE
   121                          
   122                                   INCLUDE "../libsrc/newlib/stdio/z80/asm_vfscanf_unlocked.asm"
   123                          
   124                                ENDIF
   125                          
   126                             ENDIF
