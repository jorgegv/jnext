   723                             IF __Z180
   724                          
   725                                PUBLIC __IO_VECTOR_BASE
   726                          
   727                                IF __crt_io_vector_base < 0
   728                          
   729                                   IF (__crt_org_vector_table < 0)
   730                          
   731                                      IF (-__crt_org_vector_table) & 0x1f
   732                          
   733                                         "Cannot place __IO_VECTOR_BASE at start of interrupt vector table"
   734                          
   735                                      ELSE
   736                          
   737                                         defc __IO_VECTOR_BASE = (-__crt_org_vector_table) & 0xe0
   738                          
   739                                      ENDIF
   740                          
   741                                   ELSE
   742                          
   743                                      IF __crt_org_vector_table & 0x1f
   744                          
   745                                         "Cannot place __IO_VECTOR_BASE at start of interrupt vector table"
   746                          
   747                                      ELSE
   748                          
