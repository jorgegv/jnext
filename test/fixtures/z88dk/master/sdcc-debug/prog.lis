  6523                          ; ------------------------------------------
  6524                          ; Raspberry Pi GPIO
  6525                          ; ------------------------------------------
  6526                          ; Two 28-bit registers with the least significant byte first. Each bit is one GPIO pin
  6527                          
  6528                          ; A set bit enables output on that pin (pins 1:0 cannot be enabled)
  6529                          defc __REG_PI_GPIO_OUTPUT_ENABLE_0 = 0x90
  6530                          defc __REG_PI_GPIO_OUTPUT_ENABLE_1 = 0x91
  6531                          defc __REG_PI_GPIO_OUTPUT_ENABLE_2 = 0x92
  6532                          defc __REG_PI_GPIO_OUTPUT_ENABLE_3 = 0x93
  6533                          
  6534                          ; Read or write the pin state. Writes reach only the pins with output enabled
  6535                          defc __REG_PI_GPIO_0 = 0x98
  6536                          defc __REG_PI_GPIO_1 = 0x99
  6537                          defc __REG_PI_GPIO_2 = 0x9A
  6538                          defc __REG_PI_GPIO_3 = 0x9B
  6539                          
  6540                          ; ------------------------------------------
  6541                          ; Raspberry Pi peripheral enable
  6542                          ; ------------------------------------------
  6543                          
  6544                          defc __REG_PI_PERIPHERAL_ENABLE = 0xA0
  6545                          
  6546                          ; Enable the uart on GPIO 14 and 15 (overrides gpio)
  6547                          defc __RPPE_ENABLE_UART = 0x20
  6548                          
  6549                          ; Connect Rx to GPIO 14 and Tx to GPIO 15 (to talk to a pi) instead of Rx to 15 and Tx to 14 (for pi hats)
  6550                          defc __RPPE_UART_RX_ON_GPIO_14 = 0x10
  6551                          
  6552                          ; Enable I2C on GPIO 2 and 3 (overrides gpio)
  6553                          defc __RPPE_ENABLE_I2C = 0x08
  6554                          
  6555                          ; Enable SPI on GPIO 7 to 11 (overrides gpio)
  6556                          defc __RPPE_ENABLE_SPI = 0x01
  6557                          
  6558                          ; ------------------------------------------
  6559                          ; Raspberry Pi I2S audio control
  6560                          ; ------------------------------------------
  6561                          
  6562                          defc __REG_PI_I2S_AUDIO_CONTROL = 0xA2
  6563                          
  6564                          ; I2S enable (bits 7:6)
  6565                          defc __RPIAC_I2S_OFF = 0x00
  6566                          defc __RPIAC_I2S_MONO_RIGHT = 0x40
  6567                          defc __RPIAC_I2S_MONO_LEFT = 0x80
  6568                          defc __RPIAC_I2S_STEREO = 0xC0
  6569                          
  6570                          ; PCM_DOUT from the pi and PCM_DIN to the pi (for a pi) instead of the reverse (for pi hats)
  6571                          defc __RPIAC_PCM_DOUT_FROM_PI = 0x10
  6572                          
  6573                          ; Mute each side
  6574                          defc __RPIAC_MUTE_LEFT = 0x08
  6575                          defc __RPIAC_MUTE_RIGHT = 0x04
  6576                          
  6577                          ; Reserved bit that must be written as 1
  6578                          defc __RPIAC_RESERVED_SET = 0x02
  6579                          
  6580                          ; Direct the i2s audio to EAR on port 0xfe
  6581                          defc __RPIAC_I2S_TO_EAR = 0x01
  6582                          
  6583                          
  6584                          PUBLIC __REG_PI_GPIO_OUTPUT_ENABLE_0
  6585                          PUBLIC __REG_PI_GPIO_OUTPUT_ENABLE_1
  6586                          PUBLIC __REG_PI_GPIO_OUTPUT_ENABLE_2
  6587                          PUBLIC __REG_PI_GPIO_OUTPUT_ENABLE_3
  6588                          PUBLIC __REG_PI_GPIO_0
  6589                          PUBLIC __REG_PI_GPIO_1
  6590                          PUBLIC __REG_PI_GPIO_2
  6591                          PUBLIC __REG_PI_GPIO_3
  6592                          PUBLIC __REG_PI_PERIPHERAL_ENABLE
  6593                          PUBLIC __RPPE_ENABLE_UART
  6594                          PUBLIC __RPPE_UART_RX_ON_GPIO_14
  6595                          PUBLIC __RPPE_ENABLE_I2C
  6596                          PUBLIC __RPPE_ENABLE_SPI
  6597                          PUBLIC __REG_PI_I2S_AUDIO_CONTROL
  6598                          PUBLIC __RPIAC_I2S_OFF
  6599                          PUBLIC __RPIAC_I2S_MONO_RIGHT
  6600                          PUBLIC __RPIAC_I2S_MONO_LEFT
  6601                          PUBLIC __RPIAC_I2S_STEREO
  6602                          PUBLIC __RPIAC_PCM_DOUT_FROM_PI
  6603                          PUBLIC __RPIAC_MUTE_LEFT
  6604                          PUBLIC __RPIAC_MUTE_RIGHT
  6605                          PUBLIC __RPIAC_RESERVED_SET
  6606                          PUBLIC __RPIAC_I2S_TO_EAR
  6607                          
  6608                          
  6609                          
  6610                          ; ------------------------------------------
  6611                          ; ESP wifi GPIO
  6612                          ; ------------------------------------------
  6613                          
  6614                          ; Output enable for the ESP GPIO pins (GPIO2 is read only so its enable is fixed at 0)
  6615                          defc __REG_ESP_GPIO_OUTPUT_ENABLE = 0xA8
  6616                          
  6617                          ; Read or write the ESP GPIO pins
  6618                          defc __REG_ESP_GPIO = 0xA9
  6619                          
  6620                          ; Bits of both registers above
  6621                          defc __RESPG_GPIO0 = 0x01
  6622                          defc __RESPG_GPIO2 = 0x04
  6623                          
  6624                          
  6625                          PUBLIC __REG_ESP_GPIO_OUTPUT_ENABLE
  6626                          PUBLIC __REG_ESP_GPIO
  6627                          PUBLIC __RESPG_GPIO0
  6628                          PUBLIC __RESPG_GPIO2
  6629                          
  6630                          
  6631                          
  6632                          ; ------------------------------------------
  6633                          ; DivMMC entry points
  6634                          ; ------------------------------------------
  6635                          
  6636                          ; Enable automap on an instruction fetch from each rst address
  6637                          defc __REG_DIVMMC_ENTRY_POINTS_0 = 0xB8
  6638                          
  6639                          ; Automap always on that address (1) or only when rom3 is present (0)
  6640                          defc __REG_DIVMMC_ENTRY_POINTS_VALID_0 = 0xB9
  6641                          
  6642                          ; Instant (1) or delayed (0) mapping on that address
  6643                          defc __REG_DIVMMC_ENTRY_POINTS_TIMING_0 = 0xBA
  6644                          
  6645                          ; Bits of the three registers above (one per rst address)
  6646                          defc __RDEP0_ADDRESS_0000 = 0x01
  6647                          defc __RDEP0_ADDRESS_0008 = 0x02
  6648                          defc __RDEP0_ADDRESS_0010 = 0x04
  6649                          defc __RDEP0_ADDRESS_0018 = 0x08
  6650                          defc __RDEP0_ADDRESS_0020 = 0x10
  6651                          defc __RDEP0_ADDRESS_0028 = 0x20
  6652                          defc __RDEP0_ADDRESS_0030 = 0x40
  6653                          defc __RDEP0_ADDRESS_0038 = 0x80
  6654                          
  6655                          ; Automap on the remaining entry points
  6656                          defc __REG_DIVMMC_ENTRY_POINTS_1 = 0xBB
  6657                          
  6658                          ; Enable automap on 0x3dxx for TRDOS (instant and rom3 only)
  6659                          defc __RDEP1_TRDOS_3DXX = 0x80
  6660                          
  6661                          ; Disable automap on 0x1ff8-0x1fff (delayed)
  6662                          defc __RDEP1_DISABLE_1FF8 = 0x40
  6663                          
  6664                          ; Enable automap on the NextZXOS tape traps 0x056a and 0x04d7 (delayed and rom3 only)
  6665                          defc __RDEP1_NEXTZXOS_TAPE_056A = 0x20
  6666                          defc __RDEP1_NEXTZXOS_TAPE_04D7 = 0x10
  6667                          
  6668                          ; Enable automap on the esxdos and original DivMMC tape traps 0x0562 and 0x04c6 (delayed and rom3 only)
  6669                          defc __RDEP1_ESXDOS_TAPE_0562 = 0x08
  6670                          defc __RDEP1_ESXDOS_TAPE_04C6 = 0x04
  6671                          
  6672                          ; Enable automap on 0x0066 with the nmi button (instant or delayed)
  6673                          defc __RDEP1_NMI_0066_INSTANT = 0x02
  6674                          defc __RDEP1_NMI_0066_DELAYED = 0x01
  6675                          
  6676                          
  6677                          PUBLIC __REG_DIVMMC_ENTRY_POINTS_0
  6678                          PUBLIC __REG_DIVMMC_ENTRY_POINTS_VALID_0
  6679                          PUBLIC __REG_DIVMMC_ENTRY_POINTS_TIMING_0
  6680                          PUBLIC __RDEP0_ADDRESS_0000
  6681                          PUBLIC __RDEP0_ADDRESS_0008
  6682                          PUBLIC __RDEP0_ADDRESS_0010
  6683                          PUBLIC __RDEP0_ADDRESS_0018
  6684                          PUBLIC __RDEP0_ADDRESS_0020
  6685                          PUBLIC __RDEP0_ADDRESS_0028
  6686                          PUBLIC __RDEP0_ADDRESS_0030
  6687                          PUBLIC __RDEP0_ADDRESS_0038
  6688                          PUBLIC __REG_DIVMMC_ENTRY_POINTS_1
  6689                          PUBLIC __RDEP1_TRDOS_3DXX
  6690                          PUBLIC __RDEP1_DISABLE_1FF8
  6691                          PUBLIC __RDEP1_NEXTZXOS_TAPE_056A
  6692                          PUBLIC __RDEP1_NEXTZXOS_TAPE_04D7
  6693                          PUBLIC __RDEP1_ESXDOS_TAPE_0562
  6694                          PUBLIC __RDEP1_ESXDOS_TAPE_04C6
  6695                          PUBLIC __RDEP1_NMI_0066_INSTANT
  6696                          PUBLIC __RDEP1_NMI_0066_DELAYED
  6697                          
  6698                          
  6699                          
  6700                          ; ------------------------------------------
  6701                          ; User register
  6702                          ; ------------------------------------------
  6703                          
  6704                          ; Unused storage available to the user
  6705                          defc __REG_USER_0 = 0x7F
  6706                          
  6707                          ; ------------------------------------------
  6708                          ; I/O traps (experimental)
  6709                          ; ------------------------------------------
  6710                          ; A trap generates a multiface nmi that is flagged in REG_RESET. Traps are not
  6711                          ; triggered by the dma or while the multiface or divmmc or an external nmi is active
  6712                          
  6713                          defc __REG_IO_TRAPS = 0xD8
  6714                          
  6715                          ; Enable the +3 fdc traps on ports 0x2ffd and 0x3ffd
  6716                          defc __RIT_ENABLE_P3_FDC_TRAPS = 0x01
  6717                          
  6718                          ; Byte written during the trapped i/o write cycle
  6719                          defc __REG_IO_TRAP_WRITE = 0xD9
  6720                          
  6721                          ; Cause of the trap
  6722                          defc __REG_IO_TRAP_CAUSE = 0xDA
  6723                          
  6724                          defc __RITC_NONE = 0x00
  6725                          defc __RITC_PORT_2FFD_READ = 0x01
  6726                          defc __RITC_PORT_3FFD_READ = 0x02
  6727                          defc __RITC_PORT_3FFD_WRITE = 0x03
  6728                          
  6729                          ; --------------------------------------------------------
  6730                          ; XDEV command (issues 4 and 5 only)
  6731                          ; --------------------------------------------------------
  6732                          ; Selects the Xilinx device attached to the register and then talks to it
  6733                          
  6734                          defc __REG_XDEV_COMMAND = 0xF0
  6735                          
  6736                          ; Select mode: reads 1 in select mode. Write 1 to enter it or 0 to attach the selected device
  6737                          defc __RXC_SELECT_MODE = 0x80
  6738                          
  6739                          ; Select mode: change the selected device (write together with RXC_SELECT_MODE)
  6740                          defc __RXC_CHANGE_DEVICE = 0x40
  6741                          
  6742                          ; Select mode: device (bits 1:0)
  6743                          defc __RXC_DEVICE_MASK = 0x03
  6744                          defc __RXC_DEVICE_NONE = 0x00
  6745                          defc __RXC_DEVICE_DNA = 0x01
  6746                          defc __RXC_DEVICE_XADC = 0x02
  6747                          
  6748                          ; DNA mode: next dna bit. The first eight bits read give the length of the dna string
  6749                          defc __RXC_DNA_BIT = 0x01
  6750                          
  6751                          ; XADC mode read: busy with a conversion (BUSY) and conversion done (EOC) and sequence done (EOS)
  6752                          defc __RXC_XADC_BUSY = 0x40
  6753                          defc __RXC_XADC_EOC = 0x02
  6754                          defc __RXC_XADC_EOS = 0x01
  6755                          
  6756                          ; XADC mode write: reset the XADC (RESET) and start a conversion (CONVST)
  6757                          defc __RXC_XADC_RESET = 0x40
  6758                          defc __RXC_XADC_CONVST = 0x01
  6759                          
  6760                          ; --------------------------------------------------------
  6761                          ; XADC DRP access (issues 4 and 5 only)
  6762                          ; --------------------------------------------------------
  6763                          ; Writing REG_XADC_REGISTER starts the read or write. Leave at least six 28MHz
  6764                          ; cycles after each access
  6765                          
  6766                          defc __REG_XADC_REGISTER = 0xF8
  6767                          
  6768                          ; Write to the XADC DRP port instead of reading from it (reads as 0)
  6769                          defc __RXR_WRITE = 0x80
  6770                          
  6771                          ; DRP register address DADDR
  6772                          defc __RXR_ADDRESS_MASK = 0x7F
  6773                          
  6774                          ; DRP data bus D7:0 and D15:8. Reads store the result here and writes take the value from here
  6775                          defc __REG_XADC_DATA_L = 0xF9
  6776                          defc __REG_XADC_DATA_H = 0xFA
  6777                          
  6778                          
  6779                          PUBLIC __REG_USER_0
  6780                          PUBLIC __REG_IO_TRAPS
  6781                          PUBLIC __RIT_ENABLE_P3_FDC_TRAPS
  6782                          PUBLIC __REG_IO_TRAP_WRITE
  6783                          PUBLIC __REG_IO_TRAP_CAUSE
  6784                          PUBLIC __RITC_NONE
  6785                          PUBLIC __RITC_PORT_2FFD_READ
  6786                          PUBLIC __RITC_PORT_3FFD_READ
  6787                          PUBLIC __RITC_PORT_3FFD_WRITE
  6788                          PUBLIC __REG_XDEV_COMMAND
  6789                          PUBLIC __RXC_SELECT_MODE
  6790                          PUBLIC __RXC_CHANGE_DEVICE
  6791                          PUBLIC __RXC_DEVICE_MASK
  6792                          PUBLIC __RXC_DEVICE_NONE
  6793                          PUBLIC __RXC_DEVICE_DNA
  6794                          PUBLIC __RXC_DEVICE_XADC
  6795                          PUBLIC __RXC_DNA_BIT
  6796                          PUBLIC __RXC_XADC_BUSY
  6797                          PUBLIC __RXC_XADC_EOC
  6798                          PUBLIC __RXC_XADC_EOS
  6799                          PUBLIC __RXC_XADC_RESET
  6800                          PUBLIC __RXC_XADC_CONVST
  6801                          PUBLIC __REG_XADC_REGISTER
  6802                          PUBLIC __RXR_WRITE
  6803                          PUBLIC __RXR_ADDRESS_MASK
  6804                          PUBLIC __REG_XADC_DATA_L
  6805                          PUBLIC __REG_XADC_DATA_H
  6806                          
  6807                          
  6808                          
  6809                          
  6810                          
  6811                          
  6812                          
  6813                          
  6814                          ENDIF
