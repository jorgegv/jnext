  6073                          ; ------------------------------------------
  6074                          ; Extended keys registers
  6075                          ; ------------------------------------------
  6076                          ; Nextreg 0x68 bit 4 (RUC_CANCEL_EXTENDED_KEYS_IN_MATRIX) stops the extended
