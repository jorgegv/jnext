// Loading: the entry points, the adapters and the owner of each store: chapter 7.3.
//
// Rendered by `make docs-devguide-diagrams` into ../img/srcdbg-loaders.svg,
// which is COMMITTED. Edit this file, never the SVG.
//
// Top to bottom: who asks for a load, the function that serves it, the format
// adapters it calls (one file can be two transactions), and the owner the
// result is filed under.
//
// Palette: the page theme's pastel dark red family (see css/theme.css), as the
// other figures. Light fills, dark labels, transparent canvas.
digraph srcdbg_loaders {
    bgcolor="transparent";
    rankdir=TB;
    fontname="Helvetica";
    ranksep=0.5;
    nodesep=0.25;
    node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=10,
          fillcolor="#f7eef0", color="#8c6b70", fontcolor="#2e1c1f", margin="0.14,0.08"];
    edge [color="#8c6b70", fontname="Helvetica", fontsize=9, fontcolor="#5a3f43"];

    subgraph cluster_entry {
        label="entry points";
        fontname="Helvetica"; fontsize=10; fontcolor="#5a3f43";
        color="#d3bdc0"; style="rounded";
        e_prog [label="a program load\l--load, Debugger::load()\l"];
        e_src  [label="a source map by hand\lLoad Source Map..., --source-map\l"];
        e_map  [label="a symbol file by hand\l--map, Load MAP, load_map()\l"];
    }

    f_side [label="Debugger::load_program_sidecars(path)\ldebugger_source.cpp\lnew load generation, then the three sidecar searches\l", shape=box3d, style="filled", fillcolor="#e9d3d6"];
    f_src  [label="Debugger::load_source_map(path, accept_mismatch)\lsource_file_problem(), then looks_like_sld()\l", shape=box3d, style="filled", fillcolor="#e9d3d6"];
    f_map  [label="Debugger::load_map(path, MapFormat)\ldebugger.cpp\l", shape=box3d, style="filled", fillcolor="#e9d3d6"];

    subgraph cluster_adapters {
        label="adapters";
        fontname="Helvetica"; fontsize=10; fontcolor="#5a3f43";
        color="#d3bdc0"; style="rounded";
        l_sld  [label="load_sld()\lsource half: strict\llabel half: lenient\l"];
        l_zsrc [label="load_z88dk_source_map()\lstrict, listings beside it\l"];
        l_zsym [label="SymbolTable::load_z88dk_map()\llenient\l"];
        l_mem  [label="load_nextbuild_memory()\l"];
        l_equ  [label="load_sjasmplus_equ()\lload_z88dk_or_sjasmplus()\l"];
    }

    subgraph cluster_owner {
        label="where the result is filed";
        fontname="Helvetica"; fontsize=10; fontcolor="#5a3f43";
        color="#d3bdc0"; style="rounded";
        o_side [label="Sidecar\lreplaced or cleared by the next program load\l"];
        o_user [label="User\lnever touched by a sidecar\l"];
    }

    e_prog -> f_side;
    e_src  -> f_src;
    e_map  -> f_map;

    f_side -> l_mem  [label=" Memory.txt (.nex)"];
    f_side -> l_sld  [label=" <stem>.sld, <stem>.sld.txt"];
    f_side -> l_zsym [label=" <stem>.map: symbols,\l last, and only\l when no Memory.txt\l"];
    f_side -> l_zsrc [label=" <stem>.map: lines,\l only when no SLD file\l"];
    f_src  -> l_sld  [label=" first line |SLD.data.version|"];
    f_src  -> l_zsrc [label=" anything else"];
    f_map  -> l_equ;
    f_map  -> l_zsym;
    f_map  -> l_mem;

    l_mem  -> o_side;
    l_sld  -> o_side;
    l_zsym -> o_side;
    l_zsrc -> o_side;
    l_sld  -> o_user [style=dashed];
    l_zsrc -> o_user [style=dashed];
    l_equ  -> o_user [style=dashed];
    l_zsym -> o_user [style=dashed];
    l_mem  -> o_user [style=dashed];
}
