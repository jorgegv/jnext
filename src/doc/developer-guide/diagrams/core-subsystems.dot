// What the Emulator owns, grouped by the directory the class lives in.
//
// Rendered by `make docs-devguide-diagrams` into ../img/core-subsystems.svg,
// which is COMMITTED. Edit this file, never the SVG.
//
// This is an OWNERSHIP map, not a call graph: every name below is a member of
// Emulator (src/core/emulator.h), constructed and destroyed with it. It is
// deliberately not exhaustive — the media loaders, the recorders and the
// profiler are members too, and they live in chapters 3.8 and 3.9. Listing
// every one of them turns a map into a wall.
//
// One node per GROUP rather than one node per class, and the members are in
// the label: a cluster per group laid out either as a 340 x 2867 px column
// (rankdir=LR) or a 4127 x 212 px strip (rankdir=TB), and neither is a figure
// anyone can read inline.
//
// Palette note: the page theme's pastel dark red family (see css/theme.css).
// Light fills, dark labels, transparent canvas, so the figure reads on both
// the light and the dark theme.
digraph core_subsystems {
    bgcolor="transparent";
    rankdir=TB;
    splines=ortho;
    fontname="Helvetica";
    ranksep=0.55;
    nodesep=0.35;
    node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=10,
          fillcolor="#f7eef0", color="#8c6b70", fontcolor="#2e1c1f", margin="0.16,0.10"];
    edge [color="#b09296", arrowhead=none];

    emu [label="Emulator — src/core/emulator.{h,cpp}\nowns every box below; run_frame() drives them",
         shape=box3d, style="filled", fillcolor="#e9d3d6", fontsize=12, margin="0.25,0.14"];

    // One box round all nine, rather than nine edges from Emulator: drawing
    // the edges to row 1 only made it look as though row 1 were owned and the
    // other six were not.
    subgraph cluster_owned {
        label=""; color="#d3bdc0"; style="rounded";

    time  [label="timing — src/core\lClock · Scheduler · MachineTiming\l"];
    cpu   [label="CPU — src/cpu\lZ80Cpu (FUSE core + Z80N)\lIm2Controller\l"];
    mem   [label="memory — src/memory\lRam · Rom · Mmu · ContentionModel\l"];
    io    [label="I/O — src/port\lPortDispatch · NextReg\l"];
    // Renderer owns Ula and Lores as members (renderer.h:517-518) and takes
    // Layer2, SpriteEngine, Tilemap and PaletteManager as PARAMETERS — they
    // are Emulator's own members, siblings of renderer_. In an ownership map
    // that distinction is the whole point, so keep Layer 2 out of the
    // parenthetical.
    video [label="video — src/video\lVideoTiming · Renderer (owns Ula, Lores;\lcomposites the rest) · Layer2\lSpriteEngine · Tilemap · PaletteManager\l"];
    audio [label="audio — src/audio\lTurboSound (3x YM2149) · Dac\lBeeper · I2s · Mixer\l"];
    per   [label="peripherals — src/peripheral\lCopper · Ctc · Dma · DivMmc\lMultiface · NmiSource · I2cRtc\lSpiMaster + SdCardDevice\lUart + ESP-01\l"];
    input [label="input — src/input\lKeyboard · Joystick · KempstonMouse\l"];
    debug [label="debug backend — src/debug\lDebugState · TraceLog · CallStack\lRewindBuffer\l"];

        // Three rows of three. The rank sets must live INSIDE the cluster: a
        // rank set declared outside it claims the nodes and graphviz then
        // empties the cluster ("already in a rankset, deleted from cluster").
        {rank=same; time; cpu; mem;}
        {rank=same; io; video; audio;}
        {rank=same; per; input; debug;}
    }

    // The invisible edges are what forces the grid; without them graphviz puts
    // all nine on one rank.
    emu -> {time cpu mem} [style=invis];
    time -> io [style=invis]; cpu -> video [style=invis]; mem -> audio [style=invis];
    io -> per [style=invis]; video -> input [style=invis]; audio -> debug [style=invis];
}
