// The cold-boot reconstruct contract: chapter 3.9.3.
//
// Rendered by `make docs-devguide-diagrams` into ../img/debug-reconstruct.svg,
// which is COMMITTED. Edit this file, never the SVG.
//
// Three routes land a new machine under a live Debugger: a client's
// reset(Hard), a client's load(), and a guest NR 0x02 hard reset the loop owner
// performs. All three take the same capture before the machine goes and run the
// same re-application after it comes back
// (Debugger::Impl::reapply_after_machine_rebuild). The Debugger survives
// because emulator_frontend_cold_boot() rebuilds the Emulator at the same
// address; everything inside it, the DebugState included, is new.
//
// Palette: the page theme's pastel dark red family (see css/theme.css), as the
// other figures. Light fills, dark labels, transparent canvas.
digraph debug_reconstruct {
    bgcolor="transparent";
    rankdir=TB;
    fontname="Helvetica";
    ranksep=0.35;
    nodesep=0.35;
    node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=10,
          fillcolor="#f7eef0", color="#8c6b70", fontcolor="#2e1c1f", margin="0.14,0.08"];
    edge [color="#8c6b70", fontname="Helvetica", fontsize=9, fontcolor="#5a3f43"];

    reset [label="reset(by, Hard)\lrefused inside a delivery, or on a corrupt machine\lno LoopDriver: RefusedUnavailable\l"];
    load  [label="load(by, path)\lthrough LoopDriver::load — may load in place\l"];
    guest [label="guest NR 0x02 hard reset\lthe loop owner polls the request\l"];

    capture [label="capture before the machine goes\lpaused? and whose pause?\l(guest route: on_cold_boot_begin())\l",
             fillcolor="#e9d3d6"];
    reset -> capture;
    load  -> capture;
    guest -> capture;

    boot [label="the loop owner's cold boot\l~Emulator() · placement-new at the same address · init()\lnew DebugState, Mmu, Renderer, … — the Debugger survives\l"];
    capture -> boot [label=" LoopDriver::cold_boot\l (guest: the loop owner itself)\l"];

    subgraph cluster_reapply {
        label="reapply_after_machine_rebuild() — guest route: on_cold_boot_done()";
        fontname="Helvetica"; fontsize=10; fontcolor="#5a3f43";
        color="#d3bdc0"; style="rounded";
        r1 [label="re-publish into the new DebugState\levent table · drain + Execute hooks · machine-replaced hook\lmaster-switch mirror · eight-page seed · gates_changed()\l"];
        r2 [label="discard the latch ring\lclear the stale stop evidence: arm(None)\l"];
        r3 [label="paused stays paused, running stays running\lan owned pause comes back as User{owner}\l"];
        r4 [label="re-apply what clients asked for\lcall stack · trace · persistent breakpoints\lcoverage sink · queued screenshots · clients_changed()\l"];
        r5 [label="a fresh CTL-11 guard (rebuilt machine only)\lre-base the notification edge detector\l"];
        r1 -> r2 -> r3 -> r4 -> r5;
    }
    boot -> r1;

    kept [label="never left the Debugger\lsubscriptions · switches · symbols · bookmarks · clients\l",
          shape=note, fillcolor="#f5dfe2"];
    kept -> r4 [style=dashed, arrowhead=none];

    push [label="latch Reset{Hard}, push on_reset(Hard) to every listener\lbefore returning — reset(Hard) and the guest route always,\lload() only when it reconstructed the machine\l",
          fillcolor="#e9d3d6"];
    r5 -> push;
}
