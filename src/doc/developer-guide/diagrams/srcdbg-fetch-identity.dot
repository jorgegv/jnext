// Which memory supplied an instruction: chapter 7.1.
//
// Rendered by `make docs-devguide-diagrams` into ../img/srcdbg-fetch-identity.svg,
// which is COMMITTED. Edit this file, never the SVG.
//
// Top: the one arbiter, asked two ways (the live read, and the prediction with
// the two overlays an M1 itself can switch). Left: the RECORD, taken after the
// instruction (trace entry, call frame). Right: the PREDICTION, taken before it
// (the source lookup, the symbol lookup, the Execute gate). The three users of
// EventFilter::matches() at the bottom.
//
// Palette: the page theme's pastel dark red family (see css/theme.css), as the
// other figures. Light fills, dark labels, transparent canvas.
digraph srcdbg_fetch_identity {
    bgcolor="transparent";
    rankdir=TB;
    fontname="Helvetica";
    ranksep=0.5;
    nodesep=0.3;
    node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=10,
          fillcolor="#f7eef0", color="#8c6b70", fontcolor="#2e1c1f", margin="0.14,0.08"];
    edge [color="#8c6b70", fontname="Helvetica", fontsize=9, fontcolor="#5a3f43"];

    arb [label="Mmu::route_bits_<>()  (memory/mmu.h)\lthe one arbiter body, in the VHDL's order\lroute(addr)  /  route_with(addr, divmmc, multiface)\l-> Route { space, offset, ptr }\l",
         shape=box3d, style="filled", fillcolor="#e9d3d6", margin="0.22,0.12"];

    subgraph cluster_record {
        label="the RECORD (after the instruction)";
        fontname="Helvetica"; fontsize=10; fontcolor="#5a3f43";
        color="#d3bdc0"; style="rounded";
        m1   [label="Mmu::read_m1()\lkeeps last_m1_ = the route's space\l"];
        step [label="Emulator::step_one_instruction()\lreads Mmu::last_m1() once, if the CPU fetched\l"];
        te   [label="TraceEntry::fetch_space()\l(fetch_kind, fetch_index)\l"];
        cf   [label="CallFrame::caller_space\lCallFrame::target_space\l"];
    }

    subgraph cluster_predict {
        label="the PREDICTION (before the instruction)";
        fontname="Helvetica"; fontsize=10; fontcolor="#5a3f43";
        color="#d3bdc0"; style="rounded";
        ovl  [label="Emulator::predict_m1_overlays_(pc)\lDivMmc::active_on_m1() (automap, hold)\lMultiface::would_latch_on_m1() ($0066)\l"];
        pf   [label="Emulator::predict_fetch(pc)\l"];
        sp   [label="Debugger::source_page(addr)\l"];
        use  [label="source_location(), symbol lookup,\lthe gutter, Disassembly,\lmem_coverage_fetch()\l"];
        ev   [label="Event::space of the Execute gate\land of probe_execute()\l"];
    }

    flt [label="EventFilter::matches(ev)\lkind, range, legacy page, then space\l", fillcolor="#f5dfe2"];
    gate  [label="EventTable::filter_matches()\l(the live gate and the drain)\l", fillcolor="#f5dfe2"];
    probe [label="Debugger::probe_execute()\l", fillcolor="#f5dfe2"];
    hist  [label="history_stop_at()\l(Reverse Continue, from the trace entry)\l", fillcolor="#f5dfe2"];

    arb -> m1  [label=" route_bits_<true>\l"];
    m1  -> step;
    step -> te;
    step -> cf;

    arb -> pf  [label=" route_with()\l"];
    ovl -> pf;
    pf -> sp;
    sp -> use;
    pf -> ev;

    ev -> gate [style=dashed];
    ev -> probe [style=dashed];
    te -> hist [style=dashed];
    gate -> flt;
    probe -> flt;
    hist -> flt;
}
