# roms/ holds large, user-supplied and/or copyrighted assets (SD images,
# 48.rom, ...) that must NOT be committed. The one exception is nextboot.rom:
# the 8 KB FPGA IPL, extracted byte-for-byte from the GPLv3 ZX Spectrum Next
# FPGA core (cores/zxnext/src/rom/bootrom.vhd). jnext embeds it at link time
# and cannot build without it. jnext is GPLv3, so shipping it is compatible.
roms/*
!roms/nextboot.rom
build*/
.claude/worktrees/

# Demo build artifacts (z88dk output)
demo/*.bin
demo/*.nex
demo/*.tap
demo/*.lis
demo/*.map
demo/*.sym
demo/*.o
demo/*.reloc

test/**/*-diff.png

.claude/*.lock
.claude/last-test-triplet.txt
zesarux_*.idx

# Python cache for tools/
tools/cspect_dzrp/__pycache__/

# Task 27 T1 benchmark harness lock (runtime artifact)
test/bench/.lock
packaging/assets/*.zip
