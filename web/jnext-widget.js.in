// JNEXT widget: a ready-made player for a web page. Plain script, no
// dependencies, ASCII. Every element with class "jnext-widget" becomes a
// framed player (title bar, progress bar, toolbar, status line) built on
// jnext.mount(). If `jnext` is not loaded yet, the script loads
// jnext-@PROJECT_VERSION@.js from the directory it was loaded from.
//
//   <div class="jnext-widget" data-image="https://.../card.img"
//        data-sha256="64 hex digits" data-file="game.nex"></div>
//   <script src="jnext-widget.js"></script>
//
// data-image, data-sha256, data-file  the mount() options image.url, image.sha256, file
// data-width, data-height             the screen size in CSS pixels (640 x 512)
// data-title                          the title bar text (JNEXT)
// data-theme                          light | dark (default: the visitor's setting)
//
// All styles are injected once and start with `.jnext-widget`; each element of
// the widget resets its own properties first, so a host page's rules for
// `div` or `button` do not reach it. The player is el.jnextPlayer.
(function () {
  'use strict';

  if (window.jnextWidgetLoaded) return;
  window.jnextWidgetLoaded = true;

  var SCRIPT = document.currentScript;
  var BASE = SCRIPT && SCRIPT.src ? SCRIPT.src : document.baseURI;
  var CORE = new URL('jnext-@PROJECT_VERSION@.js', BASE).href;

  var LIGHT = '--jw-bg:#f4f5f7;--jw-fg:#1d2330;--jw-bar:#e3e6ec;--jw-line:#c5cad4;' +
    '--jw-accent:#2b6fe0;--jw-btn:#ffffff;--jw-btn-hover:#e8eefc;--jw-shadow:rgba(20,30,60,0.18);' +
    '--jw-overlay:rgba(244,245,247,0.82);--jw-err:#b3261e;';
  var DARK = '--jw-bg:#1b1e26;--jw-fg:#e6e9f0;--jw-bar:#262a35;--jw-line:#3a404f;' +
    '--jw-accent:#6ea0ff;--jw-btn:#2d3240;--jw-btn-hover:#3a4156;--jw-shadow:rgba(0,0,0,0.55);' +
    '--jw-overlay:rgba(20,22,28,0.82);--jw-err:#ff8a80;';
  var W = '.jnext-widget ';
  var CSS =
    '.jnext-widget{display:block;max-width:100%;margin:1em 0;' + LIGHT + '}' +
    '.jnext-widget[data-theme="dark"]{' + DARK + '}' +
    '@media (prefers-color-scheme:dark){.jnext-widget:not([data-theme="light"]):not([data-theme="dark"]){' + DARK + '}}' +
    W + '.jw-frame{all:initial;display:block;box-sizing:border-box;overflow:hidden;' +
      'background:var(--jw-bg);color:var(--jw-fg);border:1px solid var(--jw-line);border-radius:10px;' +
      'box-shadow:0 4px 16px var(--jw-shadow);font:13px/1.3 system-ui,sans-serif}' +
    W + '.jw-title{all:initial;display:block;box-sizing:border-box;padding:6px 12px;background:var(--jw-bar);' +
      'border-bottom:1px solid var(--jw-line);color:var(--jw-fg);font:600 13px/1.3 system-ui,sans-serif}' +
    W + '.jw-stage{all:initial;display:block;position:relative;box-sizing:border-box;background:#000}' +
    W + '.jw-progress{all:initial;display:block;position:absolute;left:0;bottom:0;height:4px;width:0;' +
      'background:var(--jw-accent);transition:width .15s}' +
    W + '.jw-tools{all:initial;display:flex;box-sizing:border-box;align-items:center;gap:6px;padding:6px 8px;' +
      'background:var(--jw-bar);border-top:1px solid var(--jw-line)}' +
    W + '.jw-btn{all:initial;display:inline-block;box-sizing:border-box;padding:4px 10px;cursor:pointer;' +
      'background:var(--jw-btn);color:var(--jw-fg);border:1px solid var(--jw-line);border-radius:6px;' +
      'font:13px/1.3 system-ui,sans-serif}' +
    W + '.jw-btn:hover{background:var(--jw-btn-hover)}' +
    W + '.jw-btn:focus-visible{outline:2px solid var(--jw-accent)}' +
    W + '.jw-btn[disabled]{opacity:.45;cursor:default}' +
    W + '.jw-btn[aria-pressed="true"]{border-color:var(--jw-accent)}' +
    W + '.jw-status{all:initial;display:block;flex:1;min-width:0;overflow:hidden;white-space:nowrap;' +
      'text-overflow:ellipsis;text-align:right;color:var(--jw-fg);font:12px/1.3 ui-monospace,monospace}' +
    W + '.jw-status.jw-error{color:var(--jw-err)}' +
    W + '.jw-frame:fullscreen{border-radius:0}';

  function injectCss() {
    if (document.getElementById('jnext-widget-css')) return;
    var s = document.createElement('style');
    s.id = 'jnext-widget-css';
    s.textContent = CSS;
    (document.head || document.documentElement).appendChild(s);
  }

  function div(cls, parent, text) {
    var e = document.createElement('div');
    e.className = cls;
    if (text) e.textContent = text;
    if (parent) parent.appendChild(e);
    return e;
  }

  function mountWidget(el) {
    if (el.jnextPlayer !== undefined) return;
    el.jnextPlayer = null;
    var num = function (name, dflt) {
      var v = parseInt(el.getAttribute('data-' + name), 10);
      return v > 0 ? v : dflt;
    };
    var width = num('width', 640), height = num('height', 512);

    var frame = div('jw-frame', el);
    frame.style.width = (width + 2) + 'px';   // the 1px border on each side
    div('jw-title', frame, el.getAttribute('data-title') || 'JNEXT');
    var stage = div('jw-stage', frame);
    var bar = div('jw-progress', stage);
    var tools = div('jw-tools', frame);
    var player = null;

    function button(label, name, onclick) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'jw-btn';
      b.setAttribute('data-jw', name);
      b.textContent = label;
      b.disabled = true;
      b.addEventListener('click', function () {
        onclick(b);
        var c = stage.querySelector('canvas');
        if (c && player && player.state === 'running') c.focus();
      });
      tools.appendChild(b);
      return b;
    }
    var muted = false;
    var pauseBtn = button('Pause', 'pause', function (b) {
      if (player.state === 'paused') { player.resume(); b.textContent = 'Pause'; }
      else if (player.state === 'running') { player.pause(); b.textContent = 'Resume'; }
    });
    button('Reset', 'reset', function () { player.reset().catch(function () {}); });
    button('Mute', 'mute', function (b) {
      muted = !muted;
      player.setVolume(muted ? 0 : 1);
      b.textContent = muted ? 'Unmute' : 'Mute';
      b.setAttribute('aria-pressed', muted ? 'true' : 'false');
    });
    if (frame.requestFullscreen) {
      button('Fullscreen', 'fullscreen', function () { frame.requestFullscreen(); });
    }
    var status = div('jw-status', tools, 'Loading...');
    function say(text, isError) {
      status.textContent = text;
      status.className = 'jw-status' + (isError ? ' jw-error' : '');
    }

    var image = el.getAttribute('data-image');
    if (!image) { say('error: data-image is missing', true); return; }
    var options = {
      image: { url: image, sha256: el.getAttribute('data-sha256') || '' },
      width: width,
      height: height,
      onProgress: function (phase, fraction) {
        bar.style.width = Math.round(fraction * 100) + '%';
        say(phase + ' ' + Math.round(fraction * 100) + '%');
      },
      onReady: function () { bar.style.width = '0'; say('running'); },
      onError: function (message) { say('error: ' + message, true); }
    };
    if (el.getAttribute('data-file')) options.file = el.getAttribute('data-file');

    var p = jnext.mount(stage, options);
    // The API's own overlay (its text and its click are the API's): only its looks are set here.
    var ov = stage.querySelector('.jnext-overlay');
    if (ov) {
      ov.style.background = 'var(--jw-overlay)';
      ov.style.color = 'var(--jw-fg)';
      ov.style.font = '600 18px system-ui,sans-serif';
    }
    p.then(function (pl) {
      player = pl;
      el.jnextPlayer = pl;
      for (var i = 0; i < tools.children.length; i++) tools.children[i].disabled = false;
      say('click the screen to start');
    }, function () { /* onError has shown it */ });
  }

  function mountAll() {
    injectCss();
    var list = document.querySelectorAll('.jnext-widget');
    for (var i = 0; i < list.length; i++) mountWidget(list[i]);
  }

  function start() {
    if (typeof jnext !== 'undefined') { mountAll(); return; }
    injectCss();
    var s = document.createElement('script');
    s.src = CORE;
    s.onload = mountAll;
    s.onerror = function () {
      var list = document.querySelectorAll('.jnext-widget');
      for (var i = 0; i < list.length; i++) list[i].textContent = 'JNEXT widget: cannot load ' + CORE;
    };
    document.head.appendChild(s);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
  else start();
})();
