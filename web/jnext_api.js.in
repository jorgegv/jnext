// jnext.mount(container, options): JNEXT in a web page. Plain script, no
// dependencies, ASCII. It is bundled (with jnext-image.js, which it calls)
// after the emulator's own code in jnext-@PROJECT_VERSION@.js and defines one
// global, `jnext`.
//
// This file knows no command-line flag and no --set key: the whole options
// object goes to the emulator (jnext_web_argv, src/platform/web_api.cpp), which
// owns the table that turns it into a command line. The only option names used
// here are the ones this layer acts on itself: card ({source, dirs}), poster, file, keepWrites,
// debug (its `transport` and `url`; the core only sees --debug-channel), width, height, wasmUrl and
// the three callbacks.
//
// Nothing is downloaded or built until the visitor clicks the player. The SD card of
// NextZXOS (SpecNext's copyrighted software, which JNEXT does not ship, host or serve) is
// then taken from the browser's cache, or made from the official zip on specnext.com: fetched
// by the page when specnext.com allows it, or chosen by the visitor from a download.
(function (root) {
  'use strict';

  var VERSION = '@PROJECT_VERSION@';
  var SCRIPT = document.currentScript;
  var DEFAULT_WASM = new URL('jnext-' + VERSION + '.wasm', SCRIPT ? SCRIPT.src : document.baseURI).href;
  var counter = 0;
  var loadSeq = 0;
  var LOG_LINES = 60;
  var CALLBACKS = ['onProgress', 'onReady', 'onError', 'onNotice'];
  // The numbers of cli::DebugProtocol (src/core/cli_options.h): the exports take them.
  var DEBUG_PROTOCOLS = { dzrp: 0, zrcp: 1, gdb: 2 };

  // "sn-emulator-26.11a.zip" -> "NextZXOS 26.11a" (the same rule as sdcard::distribution_title)
  function niceDistribution(file) {
    var m = /^sn-emulator-([0-9]+(?:\.[0-9]+)*[a-z]?)\.zip$/.exec(String(file));
    return m ? 'NextZXOS ' + m[1] : String(file);
  }

  function px(v) { return typeof v === 'number' ? v + 'px' : String(v); }

  function safeName(name) { return String(name).replace(/[^A-Za-z0-9._-]/g, '_'); }

  function fileName(url) {
    var p = String(url).split('#')[0].split('?')[0];
    return p.substring(p.lastIndexOf('/') + 1) || 'program';
  }

  // {card: PATH}: a NEX on the SD card. Only mount() takes it (load() refuses it).
  function isCardFile(f) {
    return !!f && typeof f === 'object' && Object.prototype.hasOwnProperty.call(f, 'card');
  }

  // file / load() argument -> { url } | { bytes, name } | { card } | null (not a form we know).
  function fileSpec(f) {
    if (isCardFile(f)) return { card: f.card };
    if (typeof f === 'string') return { url: f };
    if (f && typeof f === 'object' && typeof f.url === 'string') return { url: f.url };
    if (f && typeof f === 'object' && f.data !== undefined && typeof f.name === 'string') {
      return { data: f.data, name: f.name };
    }
    return null;
  }

  function bytesOf(data) {
    if (data instanceof Uint8Array) return Promise.resolve(data);
    if (data instanceof ArrayBuffer) return Promise.resolve(new Uint8Array(data));
    if (typeof Blob !== 'undefined' && data instanceof Blob) {
      return data.arrayBuffer().then(function (ab) { return new Uint8Array(ab); });
    }
    return Promise.reject(new TypeError('jnext: file data must be an ArrayBuffer, a Uint8Array or a Blob'));
  }

  // Fetch/convert a program and write it to /media/<k>-<name>. Resolves to the path.
  function installFile(mod, spec) {
    var p;
    if (spec.url !== undefined) {
      p = fetch(spec.url).then(function (r) {
        if (!r.ok) throw new Error('cannot fetch ' + spec.url + ': HTTP ' + r.status);
        return r.arrayBuffer();
      }).then(function (ab) { return { bytes: new Uint8Array(ab), name: fileName(spec.url) }; });
    } else {
      p = bytesOf(spec.data).then(function (b) { return { bytes: b, name: spec.name }; });
    }
    return p.then(function (f) {
      var path = '/media/' + (loadSeq++) + '-' + safeName(f.name);
      mod.FS.mkdirTree('/media');
      mod.FS.writeFile(path, f.bytes);
      return path;
    });
  }

  function argvOf(mod, obj) {
    var p = mod.stringToNewUTF8(JSON.stringify(obj));
    var r = mod._jnext_web_argv(p);
    mod._free(p);
    var s = mod.UTF8ToString(r);
    mod._free(r);
    var o = JSON.parse(s);
    if (o.error) throw new Error(o.error);
    return o.argv;
  }

  // The options object as the emulator reads it: functions become true, file becomes
  // what was installed (or a placeholder for the early validation), keepWrites becomes the
  // path of the writes file (false: dropped), and the internal SD-card entry is added: the
  // page never supplies it.
  function substitute(options, file, card, writes, serve) {
    var o = {};
    Object.keys(options).forEach(function (k) {
      var v = options[k];
      o[k] = typeof v === 'function' ? true : v;
    });
    // A program on the card stays {card} for the early validation (serve false); at the start it
    // becomes the path of its copy, and its directory is served to it.
    if (o.file !== undefined && fileSpec(o.file) && (!isCardFile(o.file) || serve)) o.file = file;
    if (serve) o['$serveDir'] = true;
    if (card) o['$card'] = card;   // card.source 'none': no card, the core runs --no-sdcard
    if (o.keepWrites === true) o.keepWrites = writes;
    else if (o.keepWrites === false) delete o.keepWrites;
    return o;
  }

  function mount(container, options) {
    if (!(container instanceof Element)) {
      return Promise.reject(new TypeError('jnext.mount: the first argument must be a DOM element'));
    }
    if (options === undefined) options = {};
    if (options === null || typeof options !== 'object' || Array.isArray(options)) {
      return Promise.reject(new TypeError('jnext.mount: options must be an object'));
    }
    for (var ci = 0; ci < CALLBACKS.length; ci++) {
      var cv = options[CALLBACKS[ci]];
      if (cv !== undefined && typeof cv !== 'function') {
        return Promise.reject(new TypeError("jnext.mount: option '" + CALLBACKS[ci] + "' must be a function"));
      }
    }
    if (options.keepWrites !== undefined && typeof options.keepWrites !== 'boolean') {
      return Promise.reject(new TypeError("jnext.mount: option 'keepWrites' must be a boolean"));
    }
    var n = ++counter;
    var cb = {};
    CALLBACKS.forEach(function (k) { if (typeof options[k] === 'function') cb[k] = options[k]; });
    function call(name, a, b) {
      if (!cb[name]) return;
      try { cb[name](a, b); } catch (e) { console.error('jnext: ' + name + ' threw', e); }
    }
    // The SD card (and what is derived from it) is the page layer's own business: a page cannot
    // hand in any option whose name starts with '$'.
    var dollar = Object.keys(options).filter(function (k) { return k.charAt(0) === '$'; })[0];
    if (dollar !== undefined) {
      var ce = new Error("unknown option '" + dollar + "'");
      call('onError', ce.message);
      return Promise.reject(ce);
    }

    // ---- DOM ----
    var box = document.createElement('div');
    box.className = 'jnext-player';
    box.style.cssText = 'position:relative;background:#000;overflow:hidden';
    // Property assignments, not cssText concatenation: a string that is not one length
    // is ignored by the browser and can never add declarations of its own.
    box.style.width = px(options.width === undefined ? '100%' : options.width);
    box.style.height = px(options.height === undefined ? '100%' : options.height);
    var canvas = document.createElement('canvas');
    canvas.id = 'jnext-canvas-' + n;
    canvas.tabIndex = 0;
    canvas.style.cssText = 'display:block;width:100%;height:100%;outline:none';
    canvas.addEventListener('contextmenu', function (e) { e.preventDefault(); });
    var overlay = document.createElement('div');
    overlay.className = 'jnext-overlay';
    overlay.style.cssText = 'position:absolute;left:0;top:0;right:0;bottom:0;display:flex;' +
      'align-items:center;justify-content:center;background:rgba(0,0,0,0.6);color:#fff;' +
      'font:16px sans-serif;cursor:pointer';
    overlay.textContent = 'Loading...';
    // The optional poster: a picture of the program, shown until the machine starts. A string the
    // page gave; if the picture cannot be loaded nothing is shown.
    var poster = null;
    if (typeof options.poster === 'string' && options.poster) {
      poster = document.createElement('img');
      poster.className = 'jnext-poster';
      poster.alt = '';
      poster.style.cssText = 'position:absolute;left:0;top:0;width:100%;height:100%;object-fit:contain;' +
        'pointer-events:none';
      poster.addEventListener('error', function () { if (poster && poster.parentNode) poster.parentNode.removeChild(poster); });
      poster.src = options.poster;
    }
    box.appendChild(canvas);
    if (poster) box.appendChild(poster);
    box.appendChild(overlay);
    container.appendChild(box);
    var kb = JnextTouchKeyboard.create(box, canvas);   // builds nothing until the keyboard is shown

    // ---- state ----
    var state = 'waiting';
    var mod = null;
    var log = [];
    var logMark = 0;
    var exitWaiters = [];
    var stopWaiters = [];        // stop(): resolve(exit code) once the machine has exited
    var exitCode = null;         // the status the machine exited with (null until it has)
    var outputs = [];            // the files the core wrote for an output option: { raw, key, complete }
    var waiters = [];            // { resolve, reject }: the next ready / error
    var volume = null;
    var startedSeen = false;
    var writesKey = null;        // keepWrites: the IndexedDB key of this player's saves
    var writesMeta = null;       // keepWrites: what the record is tagged with (page, card, distribution, default card)
    var persistChain = null;     // the persist in flight, if any
    var persistAgain = false;    // a write arrived while it ran
    var readyDone = false;
    var readyResolve, readyReject;
    // The debug option (validated by the emulator's early argvOf below): one entry for each protocol.
    var debugEntries = {};       // protocol -> { proto, transport, url, open, channel, ws, ... }
    var debugByProto = {};
    (function () {
      var d = options.debug;
      if (d === undefined) return;
      (Array.isArray(d) ? d : [d]).forEach(function (e) {
        if (!e || typeof e !== 'object' || typeof e.protocol !== 'string' ||
            !Object.prototype.hasOwnProperty.call(DEBUG_PROTOCOLS, e.protocol)) return;
        var entry = { name: e.protocol, proto: DEBUG_PROTOCOLS[e.protocol], transport: e.transport === 'ws' ? 'ws' : 'channel',
                      url: e.url, open: false, channel: null, ws: null, timer: null, stopped: false,
                      downLogged: false, warned: false };
        debugEntries[e.protocol] = entry;
        debugByProto[entry.proto] = entry;
      });
    })();
    var ready = new Promise(function (res, rej) { readyResolve = res; readyReject = rej; });
    ready.catch(function () {});   // reported through onError; never an unhandled rejection

    function say(text) { overlay.textContent = text; }
    function fail(message) {
      call('onError', message);
      return new Error(message);
    }
    function rejectWaiters(err) {
      var w = waiters; waiters = [];
      w.forEach(function (x) { x.reject(err); });
    }
    function progress(phase, fraction) {
      // Not over the panel that asks the visitor for the NextZXOS file: it shows its own line.
      if ((state === 'waiting' || state === 'starting') && !overlay.querySelector('.jnext-pick')) {
        say(phase + ' ' + Math.round(fraction * 100) + '%');
      }
      call('onProgress', phase, fraction);
    }

    function onEvent(type, text) {
      if (type === 'started') {
        startedSeen = true;
        if (poster && poster.parentNode) poster.parentNode.removeChild(poster);
        state = 'running';
        if (volume !== null) mod._jnext_web_set_volume(volume);
        kb.started(mod._jnext_web_touch_keyboard());
        Object.keys(debugEntries).forEach(function (k) { if (debugEntries[k].transport === 'ws') dial(debugEntries[k]); });
      } else if (type === 'ready') {
        readyDone = true;
        readyResolve();
        call('onReady');
        var w = waiters; waiters = [];
        w.forEach(function (x) { x.resolve(); });
      } else if (type === 'error') {
        var e = fail(text);
        if (!readyDone) readyReject(e);   // an error before the first ready: ready never comes
        rejectWaiters(e);
      }
    }

    function onExit(code) {
      debugShutdown();
      var wasDestroying = exitWaiters.length > 0;
      if (state !== 'destroyed') state = 'exited';
      exitCode = code;
      var sw = stopWaiters; stopWaiters = [];
      sw.forEach(function (f) { f(code); });
      var w = exitWaiters; exitWaiters = [];
      w.forEach(function (f) { f(code); });
      if (wasDestroying) return;
      overlay.style.display = 'flex';
      say('Stopped');
      if (code !== 0) {
        var e = fail('jnext exited with code ' + code);
        if (!readyDone) readyReject(e);
        rejectWaiters(e);
      } else {
        rejectWaiters(new Error('jnext: the machine has exited'));
      }
    }

    var player = {
      get state() { return state; },
      get ready() { return ready; }
    };

    function live() {
      if (state === 'destroyed') throw new Error('jnext: this player was destroyed');
    }
    function machineUp() { return state === 'running' || state === 'paused'; }
    function waitReady() {
      return new Promise(function (resolve, reject) { waiters.push({ resolve: resolve, reject: reject }); });
    }

    // After a few ms of emulation: a reset that has no ready event of its own.
    function afterFrames() {
      var before = mod._jnext_web_frame();
      return new Promise(function (resolve) {
        var t0 = Date.now();
        (function poll() {
          if (state === 'destroyed' || mod._jnext_web_frame() !== before || Date.now() - t0 > 2000) resolve();
          else setTimeout(poll, 20);
        })();
      });
    }

    // Store the card's write journal in IndexedDB. One persist runs at a time; a write that
    // arrives meanwhile sets persistAgain and the same chain stores the file once more, so the
    // last write is always the one kept. Resolves when nothing is left to store.
    function persistCardWrites() {
      if (!writesKey || !mod) return Promise.resolve();
      if (persistChain) { persistAgain = true; return persistChain; }
      var m = mod, key = writesKey;
      function run() {
        persistAgain = false;
        return JnextImage.saveCardWrites(m, key, writesMeta).then(function () {
          if (persistAgain) return run();
          persistChain = null;
        }, function (e) {
          console.warn('jnext: the saved writes could not be stored: ' + e);
          persistChain = null;
        });
      }
      persistChain = run();
      return persistChain;
    }
    function onPageHide() { persistCardWrites(); }

    Object.defineProperty(player, 'keyboardVisible', { get: function () { return kb.visible; }, enumerable: true });
    Object.defineProperty(player, '_module', { get: function () { return mod; }, enumerable: false });

    player.pause = function () {
      live();
      if (state !== 'running') return;
      mod._jnext_web_pause();
      state = 'paused';
    };
    player.resume = function () {
      live();
      if (state !== 'paused') return;
      mod._jnext_web_resume();
      state = 'running';
    };
    // The on-screen keyboard, shown or hidden by the page: that wins over --touch-keyboard.
    player.showKeyboard = function (on) {
      live();
      if (typeof on !== 'boolean') throw new TypeError('jnext: showKeyboard() takes a boolean');
      kb.show(on, true);
    };
    player.reset = function (kind) {
      live();
      if (kind === undefined) kind = 'program';
      var k = { program: 0, hard: 1, soft: 2 }[kind];
      if (k === undefined) throw new RangeError("jnext: reset kind must be 'program', 'hard' or 'soft'");
      if (!machineUp()) return Promise.reject(new Error('jnext: the machine is not running'));
      if (k === 0) {
        var w = waitReady();
        mod._jnext_web_reset(0);
        return w;
      }
      mod._jnext_web_reset(k);
      return afterFrames();
    };
    // The NMI button (Multiface): opens NextZXOS's NMI Menu. Refused, with the reason, when the
    // card source is 'none' (no Multiface ROM). A refusal is the call's own error, not onError.
    player.nmi = function () {
      live();
      if (!machineUp()) return Promise.reject(new Error('jnext: the machine is not running'));
      var why = mod._jnext_web_nmi();
      if (why) return Promise.reject(new Error(mod.UTF8ToString(why)));
      return afterFrames();
    };
    // Forget what the guest wrote to the card (keepWrites) and restart the program.
    player.resetCard = function () {
      live();
      if (!machineUp()) return Promise.reject(new Error('jnext: the machine is not running'));
      if (!writesKey) return Promise.reject(new Error('jnext: resetCard() needs the keepWrites option'));
      var w = waitReady();
      if (mod._jnext_web_reset_card() !== 0) {
        rejectWaiters(new Error('jnext: resetCard() needs the keepWrites option'));
      }
      return w;
    };
    player.load = function (file) {
      live();
      if (isCardFile(file)) {
        return Promise.reject(new TypeError("jnext: load(): a program on the card is given to mount() as file: {card}"));
      }
      var spec = fileSpec(file);
      if (!spec) return Promise.reject(new TypeError('jnext: load() takes a URL, {url} or {data, name}'));
      if (!machineUp()) return Promise.reject(new Error('jnext: the machine is not running'));
      return installFile(mod, spec).then(function (path) {
        live();
        var w = waitReady();
        var p = mod.stringToNewUTF8(path);
        var why = mod._jnext_web_load(p);
        mod._free(p);
        if (why) {
          var e = fail(mod.UTF8ToString(why));
          rejectWaiters(e);
          return w;   // rejected just above
        }
        return w;
      }, function (e) { throw fail(e.message); });
    };
    // A .jns snapshot of the running machine, as a Uint8Array: for the page to keep, offer as a
    // download, or give back to load() as {data, name}. Written to a scratch file of the page's
    // in-memory file system, read back, deleted.
    var snapshotSeq = 0;
    player.saveSnapshot = function () {
      live();
      if (!machineUp()) return Promise.reject(new Error('jnext: the machine is not running'));
      var path = '/tmp/jnext-page-' + (++snapshotSeq) + '.jns';
      var p = mod.stringToNewUTF8(path);
      var why = mod._jnext_web_save_snapshot(p);
      mod._free(p);
      if (why) {
        var e = fail(mod.UTF8ToString(why));
        return Promise.reject(e);
      }
      try {
        var bytes = mod.FS.readFile(path);
        mod.FS.unlink(path);
        return Promise.resolve(bytes);
      } catch (x) {
        return Promise.reject(fail('jnext: the snapshot could not be read back: ' + (x && x.message ? x.message : String(x))));
      }
    };
    // An RZX recording of the machine as it is now (not on a Next). stopRzxRecording() resolves to
    // the file's bytes (a Uint8Array) for the page to offer as a download or give back to load() as
    // {data, name}. The file is a scratch one of the page's in-memory file system, read back and
    // deleted. A reset or a load() ends a recording early; the bytes are still returned.
    var rzxPath = null, rzxSeq = 0;
    player.startRzxRecording = function () {
      live();
      if (!machineUp()) return Promise.reject(new Error('jnext: the machine is not running'));
      if (rzxPath) return Promise.reject(new Error('jnext: the last RZX recording has not been collected; call stopRzxRecording() first'));
      var path = '/tmp/jnext-page-' + (++rzxSeq) + '.rzx';
      var p = mod.stringToNewUTF8(path);
      var why = mod._jnext_web_rzx_record(p);
      mod._free(p);
      if (why) return Promise.reject(fail(mod.UTF8ToString(why)));
      rzxPath = path;
      return Promise.resolve();
    };
    player.stopRzxRecording = function () {
      live();
      if (!machineUp()) return Promise.reject(new Error('jnext: the machine is not running'));
      if (!rzxPath) return Promise.reject(new Error('jnext: no RZX recording is running'));
      var path = rzxPath;
      rzxPath = null;
      var p = mod.stringToNewUTF8(path);
      var why = mod._jnext_web_rzx_stop(p);
      mod._free(p);
      var gone = function () { try { mod.FS.unlink(path); } catch (x) { /* not there */ } };
      if (why) { gone(); return Promise.reject(fail(mod.UTF8ToString(why))); }
      if (!mod.FS.analyzePath(path).exists) return Promise.reject(fail('jnext: the RZX recording was not written'));
      try {
        var bytes = mod.FS.readFile(path);
        gone();
        return Promise.resolve(bytes);
      } catch (x) {
        gone();
        return Promise.reject(fail('jnext: the RZX recording could not be read back: ' + (x && x.message ? x.message : String(x))));
      }
    };
    // ---- the files JNEXT writes: listFiles(), readFile(), stop() ----
    // The core reports each file it writes for an output option (--wav-record, --tape-save,
    // --profile-output, --delayed-screenshot, ...) to onFile(): the first time with complete false
    // (the writer has it open), then true (finished for good), or only true for a file written at
    // once. This layer knows no flag: it holds the paths and nothing else.
    //
    // OWN is the player's own locations, which no member ever lists or returns, whoever wrote them
    // and whatever an output option was aimed at: /sdcard (the SD card, CARD_PATH of jnext-image.js,
    // which is copyrighted NextZXOS), /jnext (JNEXT_CONFIG_DIR below: the warm-start recording, the
    // card-writes records, settings) and /media (installFile() and copyProgram(): the programs, and
    // the copies off the card). Every test is on the CANONICAL path of the page's own file system
    // (`..`, `.`, a relative name and symlinks resolved), so a name spelt round the guard lands on it.
    var OWN = ['/sdcard', '/jnext', '/media'];
    function canon(p) {
      try { return mod.FS.lookupPath(p, { follow: true }).path; } catch (e) { return p; }
    }
    function own(c) {
      return OWN.some(function (r) { return c === r || c.indexOf(r + '/') === 0; });
    }
    function regularFile(c) {
      try {
        var st = mod.FS.stat(c);
        return mod.FS.isFile(st.mode) ? st : null;
      } catch (e) { return null; }
    }
    function onFile(path, complete) {
      if (!mod) return;
      var key = canon(path), e = null;
      for (var i = 0; i < outputs.length; i++) if (outputs[i].key === key) { e = outputs[i]; break; }
      if (!e) { e = { raw: path, key: key, complete: false }; outputs.push(e); }
      e.complete = !!complete;
    }
    // The entry whose file, canonical now, is `c`.
    function outputFor(c) {
      for (var i = 0; i < outputs.length; i++) if (canon(outputs[i].raw) === c) return outputs[i];
      return null;
    }
    // The files this player's machine wrote, in the order they were begun: [{path, size, complete}].
    player.listFiles = function () {
      live();
      var out = [], seen = {};
      outputs.forEach(function (e) {
        var c = canon(e.raw);
        if (own(c) || seen[c]) return;
        var st = regularFile(c);
        if (!st) return;
        seen[c] = true;
        out.push({ path: c, size: st.size, complete: e.complete });
      });
      return out;
    };
    // A copy of the bytes of a finished file listFiles() gave. A refusal is the caller's own error,
    // not onError (as resetCard()); a failed read of a file that is there is onError's.
    player.readFile = function (path) {
      live();
      if (typeof path !== 'string') {
        return Promise.reject(new TypeError('jnext: readFile() takes a path that listFiles() gives'));
      }
      var c = canon(path);
      if (own(c)) {
        return Promise.reject(new Error('jnext: ' + path + " is one of the player's own files (the SD card and what " +
                                        'the player keeps); readFile() never returns them'));
      }
      var e = outputFor(c);
      if (!e || !regularFile(c)) {
        return Promise.reject(new Error('jnext: ' + path + " is not a file this player's machine wrote"));
      }
      if (!e.complete) {
        return Promise.reject(new Error('jnext: ' + path + ' is still being written (listFiles() says when it is ' +
                                        'complete; stop() ends the machine)'));
      }
      try {
        return Promise.resolve(mod.FS.readFile(c));
      } catch (x) {
        return Promise.reject(fail('jnext: ' + path + ' could not be read: ' + (x && x.message ? x.message : String(x))));
      }
    };
    // End the machine and keep the player and its files: resolves with the exit status once the
    // machine has exited, which is after every writer has finished its file. A stopped player cannot
    // start again; stop() on one resolves with the same status.
    player.stop = function () {
      live();
      if (state === 'exited' && exitCode !== null) return Promise.resolve(exitCode);
      if (!machineUp()) return Promise.reject(new Error('jnext: the machine is not running'));
      return new Promise(function (resolve) {
        stopWaiters.push(resolve);
        mod._jnext_web_quit();
      });
    };
    player.setVolume = function (v) {
      live();
      if (typeof v !== 'number' || !isFinite(v) || v < 0 || v > 1) {
        throw new RangeError('jnext: the volume must be a number between 0 and 1');
      }
      volume = v;
      if (startedSeen && state !== 'exited') mod._jnext_web_set_volume(v);
    };

    // ---- the debug channels (the `debug` option) ----
    // A session is opened by the client (open(), or a `open` message of the WebSocket link), carried
    // by the emulator's PipeChannel (src/remote/pipe_transport.h) and ended by either side. Bytes
    // from the machine arrive in onDebug(), after a tick, and reach the page from a microtask: a page
    // handler never runs inside a call into the module, so it cannot re-enter it mid-tick.
    function fireClose(entry) {
      queueMicrotask(function () {
        if (entry.transport === 'ws') {
          if (entry.ws && entry.ws.readyState === 1) entry.ws.send('close');
        } else if (entry.channel && typeof entry.channel.onClose === 'function') {
          try { entry.channel.onClose(); } catch (e) { console.error('jnext: debug channel onClose threw', e); }
        }
      });
    }
    function onDebug(proto, kind, bytes) {
      var entry = debugByProto[proto];
      if (!entry || !entry.open) return;   // data for a channel that is not open is dropped
      if (kind === 0) {
        queueMicrotask(function () {
          if (entry.transport === 'ws') {
            if (entry.ws && entry.ws.readyState === 1) entry.ws.send(bytes);
          } else if (entry.channel && typeof entry.channel.onData === 'function') {
            try { entry.channel.onData(bytes); } catch (e) { console.error('jnext: debug channel onData threw', e); }
          }
        });
      } else {
        entry.open = false;   // the machine ended the session (data was queued before this)
        fireClose(entry);
      }
    }
    function debugOpen(entry) {
      live();
      if (!(startedSeen && machineUp())) throw new Error('jnext: the machine is not running');
      if (entry.open) throw new Error('jnext: the debug channel is already open');
      var rc = mod._jnext_web_debug_open(entry.proto);
      if (rc !== 0) throw new Error(rc === 2 ? 'jnext: the debug channel is busy: the machine has not reported the last session ended'
                                             : 'jnext: no debug channel for ' + entry.name);
      entry.open = true;
    }
    function debugSend(entry, data) {
      live();
      if (!entry.open) throw new Error('jnext: the debug channel is not open');
      var u8;
      if (data instanceof Uint8Array) u8 = data;
      else if (data instanceof ArrayBuffer) u8 = new Uint8Array(data);
      else throw new TypeError('jnext: debug channel send() takes a Uint8Array or an ArrayBuffer');
      var ptr = mod._malloc(u8.length || 1);
      mod.HEAPU8.set(u8, ptr);
      var rc = mod._jnext_web_debug_send(entry.proto, ptr, u8.length);
      mod._free(ptr);
      if (rc === 3) throw new RangeError('jnext: the debug channel input is full');
      if (rc !== 0) throw new Error('jnext: the debug channel did not take the bytes (' + rc + ')');
    }
    function debugClose(entry) {
      live();
      if (!entry.open) throw new Error('jnext: the debug channel is not open');
      entry.open = false;
      mod._jnext_web_debug_close(entry.proto);
    }
    function makeChannel(entry) {
      var ch = { onData: null, onClose: null };
      Object.defineProperty(ch, 'isOpen', { get: function () { return entry.open; }, enumerable: true });
      ch.open = function () { debugOpen(entry); };
      ch.send = function (bytes) { debugSend(entry, bytes); };
      ch.close = function () { debugClose(entry); };
      return ch;
    }
    // The WebSocket link of a 'ws' entry: persistent, redialled every second while the player runs.
    function linkDown(entry) {
      entry.ws = null;
      if (entry.open) {   // the client behind the link is gone
        entry.open = false;
        if (mod && !entry.stopped) { try { mod._jnext_web_debug_close(entry.proto); } catch (e) { /* module gone */ } }
      }
      if (!entry.downLogged) {
        entry.downLogged = true;
        console.warn('jnext: the debug link to ' + entry.url + ' is down; retrying every second');
      }
      if (!entry.stopped) entry.timer = setTimeout(function () { entry.timer = null; dial(entry); }, 1000);
    }
    function dial(entry) {
      if (entry.stopped || state === 'destroyed' || state === 'exited') return;
      var ws;
      try { ws = new WebSocket(entry.url); } catch (e) { linkDown(entry); return; }
      ws.binaryType = 'arraybuffer';
      entry.ws = ws;
      ws.onopen = function () { entry.downLogged = false; };
      ws.onerror = function () { /* the close that follows is the news */ };
      ws.onclose = function () { if (entry.ws === ws) linkDown(entry); };
      ws.onmessage = function (ev) {
        if (entry.ws !== ws) return;
        if (typeof ev.data === 'string') {
          if (ev.data === 'open') {
            try { debugOpen(entry); } catch (e) { if (ws.readyState === 1) ws.send('close'); }
          } else if (ev.data === 'close') {
            if (entry.open) { try { debugClose(entry); } catch (e) { /* module gone */ } }
            // The confirmation the bridge waits for before it admits the next client: everything this
            // side sent for the old session (its last bytes, its own `close`) went before it.
            if (ws.readyState === 1) ws.send('closed');
          } else if (!entry.warned) {
            entry.warned = true;
            console.warn('jnext: an unknown message of the debug link was ignored');
          }
        } else if (entry.open) {
          try { debugSend(entry, new Uint8Array(ev.data)); }
          catch (e) {
            if (entry.open) { try { debugClose(entry); } catch (x) { /* gone */ } }
            if (ws.readyState === 1) ws.send('close');
          }
        }
      };
    }
    // The player ends (destroy(), the machine exiting): every open session ends, once, and the links stop.
    function debugShutdown() {
      Object.keys(debugEntries).forEach(function (k) {
        var entry = debugEntries[k];
        var wasOpen = entry.open;
        entry.open = false;
        entry.stopped = true;
        if (entry.timer) { clearTimeout(entry.timer); entry.timer = null; }
        if (wasOpen) fireClose(entry);
        if (entry.ws) {
          var ws = entry.ws;
          // The close message is queued by fireClose before this: send order is microtask order.
          queueMicrotask(function () { try { ws.close(); } catch (e) { /* already closed */ } });
        }
      });
    }
    player.debugChannel = function (protocol) {
      live();
      var entry = typeof protocol === 'string' && Object.prototype.hasOwnProperty.call(debugEntries, protocol)
        ? debugEntries[protocol] : null;
      if (!entry) throw new Error("jnext: the page has no debug entry for '" + protocol + "'");
      if (entry.transport === 'ws') throw new Error("jnext: the debug channel '" + protocol + "' is served over WebSocket");
      return entry.channel || (entry.channel = makeChannel(entry));
    };

    player.destroy = function () {
      live();
      var wasUp = machineUp();
      var finish = function () {
        debugShutdown();
        kb.destroy();
        // SDL closes its AudioContext only with the playback device, and the loop's exit leaves it
        // running: close it here, after the machine has exited, so a destroyed player holds no audio.
        var ac = mod && mod.SDL3 && mod.SDL3.audioContext;
        if (ac && ac.state !== 'closed') { try { ac.close(); } catch (e) { /* already gone */ } }
        state = 'destroyed';
        if (box.parentNode) box.parentNode.removeChild(box);
        window.removeEventListener('pagehide', onPageHide);
        // The saves are stored before the module is dropped and before destroy() resolves.
        return persistCardWrites().then(function () { mod = null; });
      };
      if (!wasUp) return finish();
      return new Promise(function (resolve) {
        var done = false;
        function end() { if (!done) { done = true; finish().then(resolve); } }
        exitWaiters.push(end);
        setTimeout(end, 2000);
        mod._jnext_web_quit();
      });
    };

    // ---- the module, the card, the program ----
    function failMount(e) {
      kb.destroy();
      if (box.parentNode) box.parentNode.removeChild(box);
      state = 'destroyed';
      throw fail(e && e.message ? e.message : String(e));
    }

    // A failure after the click: the player stays, stopped, with the reason on the overlay.
    function failStart(e) {
      state = 'exited';
      var msg = e && e.message ? e.message : String(e);
      var err = fail(msg);
      if (!readyDone) readyReject(err);
      rejectWaiters(err);
      overlay.style.display = 'flex';
      overlay.textContent = 'Stopped: ' + msg;
    }

    function stop(ev) { ev.stopPropagation(); }

    // The visitor must fetch the official file himself: say what it is, where it is, and take
    // the file he chose. Resolves with the card once a file has been accepted; a refused file
    // keeps the panel up with the reason and the visitor can choose again.
    function pickPanel(pins, reason) {
      return new Promise(function (resolve) {
        overlay.textContent = '';
        overlay.style.cursor = 'default';
        var panel = document.createElement('div');
        panel.className = 'jnext-pick';
        panel.style.cssText = 'max-width:90%;text-align:center;font:14px/1.4 sans-serif;cursor:default';
        function para(text) {
          var p = document.createElement('p');
          p.style.cssText = 'margin:6px 0';
          p.textContent = text;
          panel.appendChild(p);
          return p;
        }
        para("This player needs NextZXOS, the ZX Spectrum Next's operating system. NextZXOS is " +
             "SpecNext's copyrighted software: JNEXT does not ship, host or serve it.");
        var p2 = para('1. Download ' + pins.file + ' from specnext.com: ');
        var a = document.createElement('a');
        a.href = pins.url;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        a.textContent = pins.file;
        a.style.cssText = 'color:#8fb8ff';
        p2.appendChild(a);
        var p3 = para('2. Choose the downloaded file: ');
        var input = document.createElement('input');
        input.type = 'file';
        input.accept = '.zip,application/zip';
        input.style.display = 'none';
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = 'Choose the file...';
        btn.style.cssText = 'font:inherit;padding:2px 10px;cursor:pointer';
        btn.addEventListener('click', function () { input.click(); });
        p3.appendChild(btn);
        panel.appendChild(input);
        para("The SD card your browser makes from it stays in the visitor's browser, for this site " +
             'only. Nothing is sent anywhere.');
        var last = para(reason || '');
        last.className = 'jnext-pick-reason';
        ['click', 'change'].forEach(function (t) { panel.addEventListener(t, stop); });
        input.addEventListener('change', function () {
          var f = input.files && input.files[0];
          if (!f) return;
          btn.disabled = true;
          last.textContent = '';
          JnextImage.buildFromFile(mod, pins, f, function (ph, fr) {
            last.textContent = 'Making the card... ' + Math.round(fr * 100) + '%';
            progress(ph, fr);
          }).then(function (card) {
            if (panel.parentNode) panel.parentNode.removeChild(panel);
            resolve(card);
          }, function (e) {
            last.textContent = e && e.message ? e.message : String(e);
            input.value = '';
            btn.disabled = false;
          });
        });
        overlay.appendChild(panel);
        progress('choose', 0);
      });
    }

    // The SD card: a development card the seam names (localhost only), the one a visit kept, or
    // one made now from the official zip. -> Promise<{path, sha256}>, the card in /sdcard/image.img.
    function obtainCard(seam, pins) {
      // 'none': a NEX that needs no NextZXOS runs with no card; nothing is fetched or asked.
      if (noCard) { progress('download', 1); return Promise.resolve(null); }
      if (seam && seam.card) {
        return JnextImage.fetchImage(seam.card, progress).then(function (image) {
          var inst = JnextImage.installImage(mod, image);
          return { path: inst[1], sha256: inst[3] };
        });
      }
      var source = (options.card && options.card.source) || 'auto';
      return JnextImage.cachedCard(mod, pins).then(function (hit) {
        if (hit) { progress('download', 1); return hit; }
        if (source === 'pick') return pickPanel(pins, '');
        var fetchIt = function () {
          return JnextImage.fetchDistribution(mod, pins, progress).catch(function (e) {
            if (source === 'fetch') {
              throw new Error('cannot read the NextZXOS distribution from specnext.com: ' + pins.url + ': ' +
                              (e && e.message ? e.message : String(e)) +
                              (e instanceof TypeError ? ' (a network error, or the server does not allow cross-origin ' +
                                                         'reads: no Access-Control-Allow-Origin header)' : ''));
            }
            return pickPanel(pins, e && e.message ? e.message : String(e));
          });
        };
        if (source === 'fetch') return fetchIt();
        return JnextImage.probe(pins, seam && seam.probeTimeoutMs).then(function (pr) {
          return pr.ok ? fetchIt() : pickPanel(pins, pr.reason);
        });
      });
    }

    // A program on the card (file: {card}): its directory, with everything below it, is copied out
    // of the card now in memory into a directory of its own, and the copy is what is loaded and
    // served to the esxDOS stand-in. Resolves to the copied NEX's path.
    var serve = false;
    function copyProgram(nex) {
      var dest = '/media/' + (loadSeq++) + '-card';
      mod.FS.mkdirTree('/media');
      var a = mod.stringToNewUTF8('/sdcard/image.img'), b = mod.stringToNewUTF8(nex), c = mod.stringToNewUTF8(dest);
      var r = mod._jnext_card_copy_program(a, b, c);
      mod._free(a); mod._free(b); mod._free(c);
      var s = mod.UTF8ToString(r);
      mod._free(r);
      var o = JSON.parse(s);
      return o.error ? Promise.reject(new Error(o.error)) : Promise.resolve(o.path);
    }

    var noCard = !!(options.card && options.card.source === 'none');
    var wasmUrl = typeof options.wasmUrl === 'string' ? options.wasmUrl : DEFAULT_WASM;
    var seam = JnextImage.devSeam();
    var pins = null;
    return createJnextModule({
      canvas: canvas,
      print: function (s) { console.log(s); },
      printErr: function (s) { log.push(s); if (log.length > LOG_LINES) log.shift(); console.warn(s); },
      onExit: onExit,
      locateFile: function (p) { return p.endsWith('.wasm') ? wasmUrl : p; },
      jnextEvent: onEvent,
      jnextDebug: onDebug,
      jnextProgress: progress,
      jnextPersistCardWrites: persistCardWrites,
      jnextFile: onFile,
      preRun: [function (m) {
        m.ENV.SDL_EMSCRIPTEN_CANVAS_SELECTOR = '#' + canvas.id;
        m.ENV.JNEXT_CONFIG_DIR = '/jnext';
      }]
    }).then(function (m) {
      mod = m;
      pins = JnextImage.distribution(mod, seam);
      // Early validation: names, shapes, types. No request has been made yet, so a refused
      // page costs nothing.
      argvOf(mod, substitute(options, 'x', noCard ? null : { path: '/sdcard/image.img', sha256: pins.cardSha256 },
                             '/jnext/card-writes/x.jsdw'));
      // card.dirs (more of the distribution on the card): the builder's canonical form of the list
      // is part of the card's identity. (A development card the seam names ignores it: that card
      // is whatever the developer serves.)
      if (options.card && Array.isArray(options.card.dirs) && options.card.dirs.length) {
        pins.dirs = JnextImage.canonicalDirs(mod, options.card.dirs);
      }
      return JnextImage.mountWarmStartStore(mod);
    }).then(function () {
      say('Click to start');
      // The click starts everything: the card, the program, the machine (browsers allow sound
      // only after a click).
      function start() {
        if (state !== 'waiting') return;
        overlay.removeEventListener('click', start);
        state = 'starting';
        overlay.style.cursor = 'default';
        say('Loading...');
        canvas.focus();
        obtainCard(seam, pins).then(function (card) {
          var fs = options.file !== undefined ? fileSpec(options.file) : null;
          serve = !!(fs && fs.card !== undefined);
          var fp = !fs ? Promise.resolve('') : serve ? copyProgram(fs.card) : installFile(mod, fs);
          // keepWrites: this card on this page has one record; its file goes back into the
          // in-memory filesystem before the machine starts.
          // GH #555: the card of this release's own distribution (not one the page or a development seam
          // supplied) is the DEFAULT card; the record is tagged with that, and the earlier saves of this
          // page made on a default card of another distribution are reset first, with a notice.
          var isDefaultCard = !(seam && seam.card) || !!(seam && seam.defaultCard);
          var wp = options.keepWrites === true
            ? JnextImage.pageHashOf(location.pathname).then(function (ph) {
                var key = card.sha256.toLowerCase() + '-' + ph;
                writesMeta = { page: ph, cardSha256: card.sha256.toLowerCase(), distribution: pins.file, defaultCard: isDefaultCard };
                var stale = isDefaultCard ? JnextImage.resetStaleWrites(ph, card.sha256, pins.file) : Promise.resolve(null);
                return stale.then(function (was) {
                  if (was) call('onNotice', 'card-writes-reset', 'The saves on this page were made on an older NextZXOS card (' +
                                niceDistribution(was) + ') and were reset: this version of the page uses ' +
                                niceDistribution(pins.file) + '.');
                  return JnextImage.loadCardWrites(mod, key);
                }).then(function (p) { writesKey = key; return p; });
              })
            : Promise.resolve('');
          return Promise.all([fp, wp]).then(function (paths) {
            return argvOf(mod, substitute(options, paths[0], card, paths[1], serve));
          });
        }).then(function (argv) {
          Object.defineProperty(player, 'argv', { value: Object.freeze(argv), enumerable: true });
          overlay.style.display = 'none';
          logMark = log.length;
          try {
            mod.callMain(argv.slice());
          } catch (e) {
            log.push(String(e));
          }
          // A bind-time --sdcard-writes-reset ran before the core's persist hook was
          // installed: store what the file is now (absent: the record goes).
          window.addEventListener('pagehide', onPageHide);
          persistCardWrites();
          if (!startedSeen && state === 'starting') {
            failStart(new Error(log.slice(logMark).join('\n') || 'jnext: the machine did not start'));
            overlay.textContent = 'Stopped';
          }
        }).catch(failStart);
      }
      overlay.addEventListener('click', start);
      return player;
    }).catch(failMount);
  }

  root.jnext = { version: VERSION, mount: mount };
})(window);
