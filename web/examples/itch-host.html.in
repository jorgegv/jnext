<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>A page that embeds a JNEXT game</title>
<style>
  body { margin: 1em; font: 14px sans-serif; }
  iframe { width: 640px; height: 512px; border: 1px solid #888; }
</style>
</head>
<body>
<p>A game from another site, the way itch.io embeds an upload in its own page:</p>
<!-- allow="gamepad" is needed for a cross-origin frame to read game controllers. -->
<iframe id="game" allow="autoplay; fullscreen; gamepad"></iframe>
<p id="msg"></p>
<script>
  // ?game=URL of the uploaded page (itch-game.html on another origin).
  // Only an http(s) URL: ?game=javascript:... would run script in this page's origin.
  var q = new URLSearchParams(location.search);
  var game = 'itch-game.html';
  try {
    var u = new URL(q.get('game') || game, location.href);
    if (u.protocol === 'http:' || u.protocol === 'https:') game = u.href;
  } catch (e) { /* not a URL: the default */ }
  document.getElementById('game').src = game;
  window.messages = [];
  window.addEventListener('message', function (e) {
    window.messages.push(String(e.data));
    document.getElementById('msg').textContent = String(e.data);
  });
</script>
</body>
</html>
