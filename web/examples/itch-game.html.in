<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>JNEXT game</title>
<style>
  html, body { margin: 0; width: 100%; height: 100%; background: #000; overflow: hidden; }
  /* A column: the player takes the frame minus the room of the "JNext" link that mount() adds under it. */
  body { display: flex; flex-direction: column; color: #ccc; }
  #player { width: 100%; flex: 1 1 0; min-height: 0; }
</style>
</head>
<body>
<div id="player"></div>
<script src="jnext-@PROJECT_VERSION@.js"></script>
<script>
  // The page an itch.io upload would contain: a player that fills the frame.
  // ?file=URL, and optionally &poster=URL: a picture shown before the click.
  var q = new URLSearchParams(location.search);
  var options = {
    onReady: function () { parent.postMessage('jnext-ready', '*'); },
    onError: function (m) { parent.postMessage('jnext-error: ' + m, '*'); }
  };
  if (q.get('file')) options.file = q.get('file');
  if (q.get('poster')) options.poster = q.get('poster');
  jnext.mount(document.getElementById('player'), options).then(function (p) { window.player = p; }, function () {});
</script>
</body>
</html>
