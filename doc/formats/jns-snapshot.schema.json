{
  "$defs": {
    "blob_decl": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "crc32": {
          "$ref": "#/$defs/hex8"
        }
      },
      "required": [
        "bytes",
        "crc32"
      ],
      "type": "object"
    },
    "hex8": {
      "pattern": "^[0-9a-f]{8}$",
      "type": "string"
    },
    "manifest": {
      "additionalProperties": false,
      "properties": {
        "capture": {
          "additionalProperties": false,
          "properties": {
            "frame": {
              "minimum": 0,
              "type": "integer"
            },
            "frame_boundary": {
              "type": "boolean"
            }
          },
          "required": [
            "frame",
            "frame_boundary"
          ],
          "type": "object"
        },
        "created": {
          "type": "string"
        },
        "format_version": {
          "minimum": 1,
          "type": "integer"
        },
        "media": {
          "additionalProperties": false,
          "properties": {
            "boot_rom_sha256": {
              "pattern": "^([0-9a-f]{64})?$",
              "type": "string"
            },
            "esxdos_root": {
              "type": "string"
            },
            "roms": {
              "additionalProperties": false,
              "properties": {
                "sha256": {
                  "additionalProperties": {
                    "pattern": "^([0-9a-f]{64})?$",
                    "type": "string"
                  },
                  "type": "object"
                },
                "source": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "sdcard": {
              "additionalProperties": false,
              "properties": {
                "content_stamp": {
                  "additionalProperties": false,
                  "properties": {
                    "mtime_utc": {
                      "type": "string"
                    },
                    "sha256": {
                      "pattern": "^([0-9a-f]{64})?$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "mtime_utc",
                    "sha256"
                  ],
                  "type": "object"
                },
                "identity": {
                  "additionalProperties": false,
                  "properties": {
                    "fat32_volume_id": {
                      "pattern": "^([0-9a-f]{8})?$",
                      "type": "string"
                    },
                    "image_bytes": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "mbr_partition_table_sha256": {
                      "pattern": "^([0-9a-f]{64})?$",
                      "type": "string"
                    },
                    "partition_lba": {
                      "maximum": 4294967295,
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "fat32_volume_id",
                    "image_bytes",
                    "mbr_partition_table_sha256",
                    "partition_lba"
                  ],
                  "type": "object"
                },
                "informational": {
                  "additionalProperties": false,
                  "properties": {
                    "fat32_bs_vollab": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "fat32_bs_vollab"
                  ],
                  "type": "object"
                },
                "mounted_path": {
                  "type": "string"
                },
                "read_only": {
                  "type": "boolean"
                }
              },
              "required": [
                "content_stamp",
                "identity",
                "informational",
                "mounted_path",
                "read_only"
              ],
              "type": "object"
            },
            "tape": {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string"
                },
                "position_tstates": {
                  "minimum": 0,
                  "type": "integer"
                },
                "realtime": {
                  "type": "boolean"
                },
                "sha256": {
                  "pattern": "^([0-9a-f]{64})?$",
                  "type": "string"
                }
              },
              "required": [
                "path",
                "position_tstates",
                "realtime",
                "sha256"
              ],
              "type": "object"
            }
          },
          "type": "object"
        },
        "members": {
          "additionalProperties": {
            "$ref": "#/$defs/blob_decl"
          },
          "propertyNames": {
            "pattern": "^mem/[a-z0-9._-]+$"
          },
          "type": "object"
        },
        "model": {
          "additionalProperties": false,
          "properties": {
            "cpu_speed_nr07": {
              "maximum": 3,
              "minimum": 0,
              "type": "integer"
            },
            "machine": {
              "enum": [
                "48k",
                "128k",
                "plus3",
                "pentagon",
                "next"
              ],
              "type": "string"
            },
            "ram_kb": {
              "minimum": 1,
              "type": "integer"
            },
            "state_model_revision": {
              "minimum": 1,
              "type": "integer"
            },
            "timing": {
              "type": "string"
            }
          },
          "required": [
            "cpu_speed_nr07",
            "machine",
            "ram_kb",
            "state_model_revision"
          ],
          "type": "object"
        },
        "preview": {
          "additionalProperties": false,
          "properties": {
            "height": {
              "minimum": 1,
              "type": "integer"
            },
            "path": {
              "const": "meta/preview.png",
              "type": "string"
            },
            "width": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "height",
            "path",
            "width"
          ],
          "type": "object"
        },
        "producer": {
          "additionalProperties": false,
          "properties": {
            "git_describe": {
              "type": "string"
            },
            "jnext_version": {
              "type": "string"
            },
            "platform": {
              "type": "string"
            }
          },
          "required": [
            "jnext_version",
            "platform"
          ],
          "type": "object"
        },
        "subsystems": {
          "items": {
            "pattern": "^[a-z0-9_]+$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "capture",
        "format_version",
        "media",
        "members",
        "model",
        "producer",
        "subsystems"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/jorgegv/jnext/schema/jns-snapshot-1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "allOf": [
    {
      "properties": {
        "manifest.json": {
          "properties": {
            "capture": {
              "properties": {
                "frame_boundary": {
                  "const": true
                }
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "manifest.json": {
          "properties": {
            "members": {
              "properties": {
                "mem/bank5-vram.bin": {
                  "properties": {
                    "bytes": {
                      "const": 16384
                    }
                  }
                },
                "mem/bank7-bram.bin": {
                  "properties": {
                    "bytes": {
                      "const": 8192
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "manifest.json": {
            "properties": {
              "members": {
                "required": [
                  "mem/ram.bin"
                ]
              }
            },
            "required": [
              "members"
            ]
          }
        },
        "required": [
          "manifest.json"
        ]
      },
      "then": {
        "properties": {
          "manifest.json": {
            "anyOf": [
              {
                "properties": {
                  "members": {
                    "properties": {
                      "mem/ram.bin": {
                        "properties": {
                          "bytes": {
                            "const": 2097152
                          }
                        }
                      }
                    }
                  },
                  "model": {
                    "properties": {
                      "ram_kb": {
                        "const": 2048
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "members": {
                    "properties": {
                      "mem/ram.bin": {
                        "properties": {
                          "bytes": {
                            "const": 1048576
                          }
                        }
                      }
                    }
                  },
                  "model": {
                    "properties": {
                      "ram_kb": {
                        "const": 1024
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "members": {
                    "properties": {
                      "mem/ram.bin": {
                        "properties": {
                          "bytes": {
                            "const": 786432
                          }
                        }
                      }
                    }
                  },
                  "model": {
                    "properties": {
                      "ram_kb": {
                        "const": 768
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "properties": {
        "manifest.json": {
          "else": {
            "properties": {
              "members": {
                "required": [
                  "mem/multiface-ram.bin"
                ]
              }
            }
          },
          "if": {
            "properties": {
              "model": {
                "properties": {
                  "machine": {
                    "const": "next"
                  }
                }
              }
            },
            "required": [
              "model"
            ]
          },
          "then": {
            "properties": {
              "members": {
                "not": {
                  "required": [
                    "mem/multiface-ram.bin"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ],
  "description": "A .jns archive presented to a validator as an object mapping each JSON member's path to its parsed document. Members under mem/ are binary and are described by their manifest declaration, not by a document here.",
  "properties": {
    "manifest.json": {
      "$ref": "#/$defs/manifest"
    }
  },
  "required": [
    "manifest.json"
  ],
  "title": "jnext .jns snapshot, format_version 1",
  "type": "object"
}
